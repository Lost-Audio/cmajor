        void start(float v)
        {
            this.reset();this.raw=0.0f;this.historyCount=0;this.historyIndex=0;this.active=true;this.firstNoise=true;
            this.velocityGain=sqrt((v*127.0f)/100.0f);
            this.phase=float[416]();this.noise=float[416]();
        }
        void advanceModel()
        {
            let step=this.raw==0.0f?1.0f:44100.0f/this.sampleRate;
            if(!this.tonal || this.released || this.modelPosition<this.modelTime(this.sustainSeconds*689.0625f))this.raw+=step;
            this.evaluate(this.modelTime(this.raw)-this.modelPosition);

            this.times=CoreDefaults::time;this.stageTimes=this.times;
            this.frequencies=CoreDefaults::frequency;this.stageFrequencies=this.frequencies;
            this.norms=CoreDefaults::norm;this.durations=CoreDefaults::duration;this.tails=CoreDefaults::tail;
            let rate=this.sampleRate,binScale=256.0f/rate,hopScale=64.0f/rate;
            while(this.lowCount<80 && WaveData::bandwidth.at(this.lowCount)<1.3f/binScale && WaveData::hz.at(this.lowCount)<rate*0.5f)++this.lowCount;
            let end=min(128,int(binScale*WaveData::k1ff050));

                while(k<78 && hz>WaveData::hz.at(k+1))++k;
                let z=(hz-WaveData::hz.at(k))/(WaveData::hz.at(k+1)-WaveData::hz.at(k));
                this.highBand.at(j)=k;this.highLeft.at(j)=max(0.0f,1.0f-abs(z));this.highRight.at(j)=max(0.0f,1.0f-abs(1.0f-z));
                this.highGain.at(j)=sqrt(1.0f/(((1.0f-z)*WaveData::bandwidth.at(k)+z*WaveData::bandwidth.at(k+1))*binScale));
                this.initialNoise.at((this.lowCount+j)*2)=WaveData::initialSpectrum.at(this.startBin+j);

                for(int q=0;q<41;++q)this.stageTimes.at(c.slot*287+c.index*41+q)=c.positions.at(q);
            if(c.kind==1 && c.index>=0 && c.index<6)
                for(int q=0;q<49;++q)this.stageFrequencies.at(c.slot*294+c.index*49+q)=c.positions.at(q);
        }
        void modelInfo(ModelInfo m)
        {
            if(m.slot<0 || m.slot>1 || !(m.norm>0.0f))return;
            for(int q=0;q<287;++q)this.times.at(m.slot*287+q)=this.stageTimes.at(m.slot*287+q);
            for(int q=0;q<294;++q)this.frequencies.at(m.slot*294+q)=this.stageFrequencies.at(m.slot*294+q);
            for(int q=0;q<7;++q)this.tails.at(m.slot*7+q)=m.tail.at(q);

                this.history.at(at+i+1)=releaseGain*(this.weights.at(i)*this.weights.at(i));
            }
            this.history.at(at)=max(this.history.at(at+1)*0.8f,this.history.at(at+1)*1.5f-this.history.at(at+2)*0.5f);
            this.history.at(at+81)=max(this.history.at(at+80)*0.8f,this.history.at(at+80)*1.5f-this.history.at(at+79)*0.5f);
            this.historyIndex=(this.historyIndex+1)%4;this.historyCount=min(4,this.historyCount+1);
        }
        void makeFeatures()

                this.scratch.at(i)=g*this.scratch.at(j)+this.a.at(i);
                this.solved.at(2*i)=(this.solved.at(2*j)*cr-ci*this.solved.at(2*j+1))+this.a.at(i)*this.phase.at(2*i);
                this.solved.at(2*i+1)=(ci*this.solved.at(2*j)+cr*this.solved.at(2*j+1))+this.a.at(i)*this.phase.at(2*i+1);
            }
            let last=this.voiceSize-1,scale=1.0f/(this.scratch.at(last)+1.0e-30f);this.solved.at(2*last)*=scale;this.solved.at(2*last+1)*=scale;
            for(int i=this.voiceSize-2;i>=0;--i)
            {
                let k=2*i,g=this.b.at(i),cr=g*this.coupling.at(k),ci=-this.coupling.at(k+1)*g,scaleBack=1.0f/(g*this.mag.at(i)+this.scratch.at(i)+1.0e-30f);
                this.solved.at(k)=((cr*this.solved.at(k+2)-ci*this.solved.at(k+3))+this.solved.at(k))*scaleBack;
                this.solved.at(k+1)=((ci*this.solved.at(k+2)+cr*this.solved.at(k+3))+this.solved.at(k+1))*scaleBack;
            }
        }
        void addNoise()
        {
            this.noiseSeed=(this.noiseSeed*1664525L+1013904223L)&0xffffffffL;
            let at=int(this.noiseSeed%int64(2048-this.voiceSize))*2;
            if(this.firstNoise){this.noise=this.initialNoise;this.firstNoise=false;}
            else
            {
                for(int i=0;i<this.lowCount;++i)
                {
                    let r=this.noise.at(2*i),v=this.noise.at(2*i+1),cr=this.noiseRe.at(i),ci=this.noiseIm.at(i),g=this.noiseGain.at(i);
                    this.noise.at(2*i)=(r*cr-v*ci)+g*WaveData::noiseTable.at(at+2*i);
                    this.noise.at(2*i+1)=(r*ci+v*cr)+g*WaveData::noiseTable.at(at+2*i+1);
                }
                for(int i=this.lowCount;i<this.voiceSize;++i){this.noise.at(2*i)=WaveData::noiseTable.at(at+2*i);this.noise.at(2*i+1)=WaveData::noiseTable.at(at+2*i+1);}
            }
            for(int i=0;i<this.voiceSize;++i)
            {
                let amp=this.amplitude.at(i),na=amp*this.noiseShare.at(i),r=this.solved.at(2*i),v=this.solved.at(2*i+1),scale=(na+amp)/(sqrt(r*r+v*v)+na+1.0e-30f);
                this.phase.at(2*i)=na*this.noise.at(2*i)+scale*r;this.phase.at(2*i+1)=scale*v+na*this.noise.at(2*i+1);
            }
        }
        void inverseFFT()
        {
            for(int i=0;i<256;++i){this.fftRe.at(i)=0.0f;this.fftIm.at(i)=0.0f;}
            this.specRe.at(4)+=this.specRe.at(4);this.specIm.at(4)=0.0f;
            for(int i=1;i<=4;++i){this.specRe.at(i+4)+=this.specRe.at(4-i);this.specIm.at(i+4)-=this.specIm.at(4-i);}
            for(int i=0;i<128;++i){this.fftRe.at(i)=this.specRe.at(i+4);this.fftIm.at(i)=this.specIm.at(i+4);}
            for(int i=1;i<128;++i){this.fftRe.at(256-i)=this.fftRe.at(i);this.fftIm.at(256-i)=-this.fftIm.at(i);}
            for(int i=0;i<256;++i)if(i<this.reversed.at(i))
            {
                let j=this.reversed.at(i),r=this.fftRe.at(i),v=this.fftIm.at(i);this.fftRe.at(i)=this.fftRe.at(j);this.fftIm.at(i)=this.fftIm.at(j);this.fftRe.at(j)=r;this.fftIm.at(j)=v;
            }
            for(int size=2;size<=256;size*=2)for(int j=0;j<size/2;++j)
            {
                let c=this.fftCos.at(j*256/size),s=this.fftSin.at(j*256/size);
                for(int k=j;k<256;k+=size)
                {
                    let b=k+size/2,x=this.fftRe.at(b)*c-this.fftIm.at(b)*s,y=this.fftRe.at(b)*s+this.fftIm.at(b)*c,r=this.fftRe.at(k),v=this.fftIm.at(k);
                    this.fftRe.at(k)=r+x;this.fftIm.at(k)=v+y;this.fftRe.at(b)=r-x;this.fftIm.at(b)=v-y;
                }
            }
        }
        void makeSpectrum()
        {
            this.specRe=float[137]();this.specIm=float[137]();
            // Native neutral single-voice processing submits the spectrum twice.
            loop(2)
            {
                for(int i=0;i<this.lowCount;++i)
                {
                    let k=this.lowBin.at(i)+4,l=this.lowLeft.at(i),r=this.lowRight.at(i),re=this.phase.at(2*i),im=this.phase.at(2*i+1);
                    this.specRe.at(k)+=re*l;this.specRe.at(k+1)+=re*r;this.specIm.at(k)+=im*l;this.specIm.at(k+1)+=im*r;
                }
                for(int j=0;j<this.highCount;++j){let k=this.startBin+j+4;this.specRe.at(k)+=this.phase.at(2*(this.lowCount+j));this.specIm.at(k)+=this.phase.at(2*(this.lowCount+j)+1);}
            }
            this.inverseFFT();
            for(int i=0;i<256;++i)this.ola.at((this.outIndex+i)%256)+=this.fftRe.at((i+128)%256)*WaveData::olaWindow.at(i);
        }
        void tick()
        {
            if(this.tonal && this.released)
            {
                this.releaseProgress+=(64.0f/this.sampleRate)/(this.releaseSeconds+0.00001f);
                if(this.releaseProgress>1.0f){this.active=false;return;}
            }
            let duration=max(this.durations.at(0),this.durations.at(1));
            if((duration<95.0f && duration+1.0f<this.modelPosition)||duration<1.0f){this.active=false;return;}
            this.advanceModel();while(this.historyCount<3)this.advanceModel();
            if(this.tonal)this.makeTonalSpectrum();
            else { this.makeFeatures();this.solvePhase();this.addNoise();this.makeSpectrum(); }
            if(this.modelPosition>=96.0f)
            {
                float peak=0.0f;for(int i=0;i<7;++i)peak=max(peak,this.speed.at(i));
                if(peak*peak<0.00001f)this.active=false;
            }
        }

        // Tonal mode reads the same model with a pitched harmonic bank.
        bool tonal,released,keyDown;
        int note,channel;
        float age,releaseProgress,pitchBend;
        float releaseSeconds,sustainSeconds,keyTracking;
        float[512] harmonicPhase,unisonPhase;
        int64 tonalRandom;
        int oscillatorShape;
        float stretchAmount;

        void silence()
        {
            this.active=false;this.keyDown=false;this.released=true;
            this.ola=float[256]();this.shelfState=0.0f;this.delay1=0.0f;this.delay2=0.0f;
        }
        void startTonal(int noteIn,int channelIn,float velocity)
        {
            // Existing overlap samples carry the previous note through its last frame.
            this.tonal=true;this.note=noteIn;this.channel=channelIn;this.keyDown=true;this.released=false;
            this.age=0.0f;this.releaseProgress=0.0f;this.harmonicPhase=float[512]();
            this.start(velocity);
        }
        void makeTonalSpectrum()
        {
            this.specRe=float[137]();this.specIm=float[137]();
            let stretchNormal=this.stretchAmount/100.0f;
            let spacingCurve=abs(stretchNormal)*(stretchNormal*0.1f);
            let pitch=440.0f*pow(2.0f,(float(this.note)+this.pitchBend-69.0f)/12.0f);
            let fundamental=pitch/max(0.5f,1.0f+spacingCurve);
            let modelFundamental=261.6199951171875f*pow(fundamental/261.6199951171875f,1.0f-this.keyTracking/100.0f);
            let halfHop=32.0f/this.sampleRate,binScale=256.0f/this.sampleRate;
            let topBand=WaveData::hz.at(79)+(WaveData::hz.at(79)-WaveData::hz.at(78));
            let limit=min(topBand,this.sampleRate*0.46f);
            let frame=((this.historyIndex+2)%4)*82;
            let amplitudeScale=sqrt(fundamental)*0.5f;
            this.tonalRandom=(this.tonalRandom*1664525L+1013904223L)&0xffffffffL;
            let unisonRate=(1.0f/1200.0f)*halfHop;
            let randomOffset=(float(this.tonalRandom)*2.3283000527563047e-10f*2.0f+0.5f)*unisonRate;
            int band=-1;
            float hz,modelHz;
            let tableStart=clamp(this.oscillatorShape,0,11)*512;
            // Negative stretch stops before the frequency steps reverse direction.
            let harmonicLimit=spacingCurve<(-0.001953125f)?min(512,int(-1.0f/spacingCurve)):512;
            for(int harmonic=0;harmonic<harmonicLimit;++harmonic)
            {
                let spacing=(float(harmonic)*spacingCurve+1.0f)*OscillatorData::spacing.at(tableStart+harmonic);
                hz+=spacing*fundamental;
                modelHz+=spacing*modelFundamental;
                if(hz>limit || modelHz>limit)break;
                while(band<79 && modelHz>WaveData::hz.at(band+1))++band;
                let lower=band<0?WaveData::hz.at(0)-(WaveData::hz.at(1)-WaveData::hz.at(0)):WaveData::hz.at(band);
                let upper=band<79?WaveData::hz.at(band+1):topBand;
                let fraction=(modelHz-lower)/(upper-lower);
                let energy=(1.0f-fraction)*this.history.at(frame+band+1)+fraction*this.history.at(frame+band+2);
                // Signed weights preserve the pulse shapes and the final harmonic fade.
                let shapeWeight=OscillatorData::levels.at(tableStart+harmonic);
                let amplitude=energy*amplitudeScale*shapeWeight;
                let phaseStep=hz*halfHop;
                let centred=this.harmonicPhase.at(harmonic)+phaseStep;
                let phaseTurns=centred-floor(centred);
                this.harmonicPhase.at(harmonic)=phaseStep+phaseTurns;
                let rotation=this.rotate(phaseTurns);
                // Visco keeps a small modulation even when Unison is set to zero.
                let phase2=this.unisonPhase.at(harmonic)+(hz*unisonRate)/(hz*randomOffset+1.0f);
                let detunePhase=phase2-floor(phase2);
                this.unisonPhase.at(harmonic)=detunePhase;
                let modulation=detunePhase*20.780000686645508f*(detunePhase-0.5f)*(detunePhase-1.0f)*0.7f;
                let sine=rotation[1]*amplitude,negativeCosine=-rotation[0]*amplitude;
                let unisonGain=1.0f-0.7f*0.7f;
                let real=sine*unisonGain-negativeCosine*modulation;
                let imaginary=sine*modulation+negativeCosine*unisonGain;
                let bin=hz*binScale,index=int(bin)+4,offset=bin-float(int(bin));
                let left=1.0f-(offset*0.27000001072883606f+0.7300000190734863f)*offset;
                let inverse=1.0f-offset;
                let right=1.0f-(inverse*0.27000001072883606f+0.7300000190734863f)*inverse;
                this.specRe.at(index)+=left*real;this.specRe.at(index+1)+=right*real;
                this.specIm.at(index)+=left*imaginary;this.specIm.at(index+1)+=right*imaginary;
            }
            this.inverseFFT();
            for(int i=0;i<256;++i)this.ola.at((this.outIndex+i)%256)+=this.fftRe.at((i+128)%256)*WaveData::olaWindow.at(i);
        }
        float render()
        {
            if(this.countdown==0){if(this.active)this.tick();this.countdown=64;this.age+=64.0f/this.sampleRate;}--this.countdown;
            let inputSample=this.ola.at(this.outIndex);this.ola.at(this.outIndex)=0.0f;this.outIndex=(this.outIndex+1)%256;
            let x=inputSample-this.shelfState*this.shelfA,y=this.shelfState*this.shelfC+x*this.shelfB;this.shelfState=x;
            var sample=this.delay2;this.delay2=this.delay1;this.delay1=y;
            return sample;
        }
    }
}

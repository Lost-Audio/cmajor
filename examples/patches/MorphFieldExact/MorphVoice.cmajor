                let k=int(bin),z=bin-float(k),g=float(pow(float64(1.0f-(1.0f-bw*binScale)*0.66f),float64(0.22f)));
                this.lowBin.at(i)=k;this.lowLeft.at(i)=this.bandWindow(z)*g;this.lowRight.at(i)=this.bandWindow(1.0f-z)*g;
                let rho=float(exp(float64(bw*WaveData::k1ff078*hopScale)))*0.5f;

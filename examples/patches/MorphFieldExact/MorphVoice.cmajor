        float modelTime(float x) { return x<25.0f?x:this.clockMapLog(x/(WaveData::clockOffset*25.0f))/WaveData::clockLog; }
        float linearTime(float x) { return x<25.0f?x:float(exp(float64(WaveData::clockLog*x)))*(WaveData::clockOffset*25.0f); }

            for(int i=0;i<79;++i)
            {
                let left=this.history.at(old+i)+this.history.at(now+i),mid=this.history.at(old+i+1)+this.history.at(now+i+1),right=this.history.at(old+i+2)+this.history.at(now+i+2);
                let oldPair=this.history.at(old+i+1)+this.history.at(old+i+2),nowPair=this.history.at(now+i+1)+this.history.at(now+i+2),nextPair=this.history.at(next+i+1)+this.history.at(next+i+2);
                let dx=(right-left)/((right+left)*WaveData::k1fefb4+mid*WaveData::k1fefd4+1.0e-30f);
                let inv=1.0f/(mid+left+right+1.0e-30f),u=mid*inv,z=abs(left-right)*inv;

                let tonal=w1*this.tone.at(k+1)+w0*this.tone.at(k),pitch=w1*this.freqTurns.at(k+1)+w0*this.freqTurns.at(k),timing=w1*this.onset.at(k+1)+w0*this.onset.at(k);
                this.a.at(i)=this.sq(max(tonal+0.3f,0.2f));this.b.at(i)=this.sq(max(timing+0.4f,0.2f));this.turns.at(i)=pitch;

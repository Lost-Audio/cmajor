            for(int c=0;c<2;++c)y=this.scatter[c].scatter(y,this.scatter[c].length);
            let gain=this.currentFeedback+float(this.cursor)*this.feedbackStep;
            for(int c=0;c<2;++c){this.notch[c]=y[c]*0.20000000298023224f-this.notch[c]*0.800000011920929f;this.low[c]=(y[c]-this.low[c])*0.009999999776482582f+this.low[c];y[c]=y[c]-(this.notch[c]+this.low[c]);this.lines[c].push(saturate(y[c]*gain)+x[c]);}
            if(++this.cursor==32){this.cursor=0;this.currentFeedback=32.0f*this.feedbackStep+this.currentFeedback;this.currentLength=this.nextLength;}return y;
        }
    }
}

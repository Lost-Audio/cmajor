            let distance=float(float(head.mirror)<head.position?this.length:0)+(float(head.mirror)-head.position);
            let target=clamp(1.0f-(delay-distance)*0.001f,0.5f,2.0f);
            head.speedStep=clamp((target-head.speed)/(float(count)*1.5f),-0.001f,0.001f);

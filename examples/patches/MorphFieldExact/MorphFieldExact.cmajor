// Two sound models feed up to eight voices and one shared effect rack.
processor MorphFieldExact [[ main ]]
{
    output stream float<2> out;
    input event float morph [[name:"Morph", min:0, max:1, init:0.5]];
    input event float level [[name:"Level", min:-36, max:6, init:0, unit:"dB"]];
    input event bool limiter [[name:"Limiter", init:false]];
    input event float limiterGain [[name:"Limiter Gain", min:0, max:48, init:0, unit:"dB"]];
    input event float limiterSpeed [[name:"Limiter Speed", min:0, max:100, init:50]];
    input event bool send1Enabled [[name:"Send 1 On", init:false]];
    input event int send1Type [[name:"Send 1 Effect", min:0, max:7, init:0, text:"Chorus|Diffuser|Plate Reverb|Room Reverb|Spring Reverb|Tempo Delay|Compressor|Stereo Fuzz"]];
    input event float send1P1 [[name:"Send 1 Control A", min:0, max:100, init:5]];
    input event float send1P2 [[name:"Send 1 Control B", min:0, max:300, init:1]];
    input event float send1Amount [[name:"Send 1 Amount", min:0, max:4, init:0]];
    input event bool send2Enabled [[name:"Send 2 On", init:false]];
    input event int send2Type [[name:"Send 2 Effect", min:0, max:7, init:1, text:"Chorus|Diffuser|Plate Reverb|Room Reverb|Spring Reverb|Tempo Delay|Compressor|Stereo Fuzz"]];
    input event float send2P1 [[name:"Send 2 Control A", min:0, max:100, init:50]];
    input event float send2P2 [[name:"Send 2 Control B", min:0, max:300, init:10]];
    input event float send2Amount [[name:"Send 2 Amount", min:0, max:4, init:0]];
    input event bool main1Enabled [[name:"Main 1 On", init:false]];
    input event int main1Type [[name:"Main 1 Effect", min:0, max:5, init:4, text:"Sticky Compressor|L.A. Optical|Upward Compressor|Limiter|Tape Simulator|Transformer Amp"]];
    input event float main1P1 [[name:"Main 1 Control A", min:0, max:100, init:50]];
    input event float main1P2 [[name:"Main 1 Control B", min:-100, max:100, init:50]];
    input event bool main2Enabled [[name:"Main 2 On", init:false]];
    input event int main2Type [[name:"Main 2 Effect", min:0, max:5, init:3, text:"Sticky Compressor|L.A. Optical|Upward Compressor|Limiter|Tape Simulator|Transformer Amp"]];
    input event float main2P1 [[name:"Main 2 Control A", min:0, max:100, init:0]];
    input event float main2P2 [[name:"Main 2 Control B", min:-100, max:100, init:50]];
    input event float tempo [[name:"Tempo", min:15, max:400, init:120, unit:"BPM"]];
    input event std::timeline::Tempo tempoIn;
    output event float hostTempo;
    input event float audition;
    input event std::midi::Message midiIn;
    input event MorphVoice::ModelCurve modelCurve;
    input event MorphVoice::ModelInfo modelInfo;
    output event int modelReady;

    input event bool tonal [[name:"Tonal Mode", init:false]];
    input event int polyphony [[name:"Voices", min:1, max:8, init:8]];
    input event float release [[name:"Release", min:0.01, max:10, init:0.2, unit:"s"]];
    input event float sustainPosition [[name:"Sustain Position", min:0.01, max:5, init:0.1, unit:"s"]];
    input event float keyTrack [[name:"Key Track", min:0, max:100, init:100, unit:"%"]];
    input event float bendRange [[name:"Pitch Bend", min:0, max:24, init:2, unit:"semitones"]];
    input event int oscillator [[name:"Oscillator", min:0, max:11, init:0, text:"Saw|Square|Pulse1|Pulse2|Octaves|Fibonacci|Metallic|RoundRobin|DrawBar|Sevenths|MajorChord|MinorChord"]];
    input event float stretch [[name:"Stretch", min:-100, max:100, init:0]];
    input event float panic;
    MorphVoice::Voice[8] voices;
    bool tonalMode;
    int64 tonalRandom=3994178745L;
    int voiceLimit=8;
    float gain=1.0f,releaseTime=0.2f,sustainTime=0.1f,keyTracking=100.0f,bendSemitones=2.0f;
    float[16] channelBend;
    int oscillatorShape;
    float stretchAmount;
    bool[16] pedal;
    ViscoDynamics::Limiter outputLimiter;
    bool limiterEnabled;
    float limiterGainDb=0.0f,limiterSpeedValue=50.0f;
    ViscoEffects::SendSlot sendFX1,sendFX2;
    ViscoEffects::MainSlot mainFX1,mainFX2;
    float sendAmount1,sendAmount2,tempoValue=120.0f;
    int64 tapeSeed=2345L,roomSeed=1L;
    bool effectsPrimed;


    event send1Enabled(bool v) { sendFX1.enabled=v; }
    event send1Type(int v) { sendFX1.select(v); }
    event send1P1(float v) { sendFX1.p1=v;sendFX1.configure(); }
    event send1P2(float v) { sendFX1.p2=v;sendFX1.configure(); }
    event send1Amount(float v) { sendAmount1=clamp(v,0.0f,4.0f); }
    event send2Enabled(bool v) { sendFX2.enabled=v; }
    event send2Type(int v) { sendFX2.select(v); }
    event send2P1(float v) { sendFX2.p1=v;sendFX2.configure(); }
    event send2P2(float v) { sendFX2.p2=v;sendFX2.configure(); }
    event send2Amount(float v) { sendAmount2=clamp(v,0.0f,4.0f); }
    event main1Enabled(bool v) { mainFX1.enabled=v; }
    event main1Type(int v) { mainFX1.select(v); }
    event main1P1(float v) { mainFX1.p1=v;mainFX1.configure(); }
    event main1P2(float v) { mainFX1.p2=v;mainFX1.configure(); }
    event main2Enabled(bool v) { mainFX2.enabled=v; }
    event main2Type(int v) { mainFX2.select(v); }
    event main2P1(float v) { mainFX2.p1=v;mainFX2.configure(); }
    event main2P2(float v) { mainFX2.p2=v;mainFX2.configure(); }
    event tempo(float v) { tempoValue=clamp(v,15.0f,400.0f); }
    event tempoIn(std::timeline::Tempo v) { if(v.bpm>0.0f){tempoValue=clamp(v.bpm,15.0f,400.0f);hostTempo <- tempoValue;} }


    event morph(float value) { for(int i=0;i<8;++i)voices.at(i).mix=clamp(value,0.0f,1.0f); }
    event level(float db) { gain=pow(10.0f,clamp(db,-36.0f,6.0f)/20.0f); }
    event limiter(bool value) { limiterEnabled=value; }
    event limiterGain(float db) { limiterGainDb=clamp(db,0.0f,48.0f);updateLimiter(); }
    event limiterSpeed(float value) { limiterSpeedValue=clamp(value,0.0f,100.0f);updateLimiter(); }
    void updateLimiter() { outputLimiter.configure(float(processor.frequency),limiterGainDb,limiterSpeedValue); }

    void stopAll()
    {
        for(int i=0;i<8;++i)voices.at(i).silence();
        pedal=bool[16]();
    }
    event panic(float value) { if(value>0.0f)stopAll(); }
    event tonal(bool value) { if(value!=tonalMode)stopAll();tonalMode=value; }
    event polyphony(int value)
    {
        voiceLimit=clamp(value,1,8);
        for(int i=voiceLimit;i<8;++i)voices.at(i).silence();
    }
    event release(float value) { releaseTime=clamp(value,0.01f,10.0f); }
    event sustainPosition(float value) { sustainTime=clamp(value,0.01f,5.0f); }
    event keyTrack(float value) { keyTracking=clamp(value,0.0f,100.0f); }
    event bendRange(float value) { bendSemitones=clamp(value,0.0f,24.0f); }
    event oscillator(int value) { oscillatorShape=clamp(value,0,11); }
    event stretch(float value) { stretchAmount=clamp(value,-100.0f,100.0f); }

    void noteOn(int note,int channel,float velocity)
    {
        if(!tonalMode){voices.at(0).tonal=false;voices.at(0).start(velocity);return;}
        int selected=0;
        float best=1.0e20f;
        for(int i=0;i<voiceLimit;++i)
        {
            if(!voices.at(i).active){selected=i;break;}
            // In this mode, Visco replaces the oldest busy voice.
            let score=1.0f/(max(0.0f,voices.at(i).age)+1.0f);
            if(score<best){best=score;selected=i;}
        }
        voices.at(selected).startTonal(note,channel,velocity);
    }
    event audition(float value) { if(value>0.0f)noteOn(60,0,clamp(value,0.0f,1.0f));else noteOff(60,0); }
    void noteOff(int note,int channel)
    {
        if(!tonalMode)return;
        for(int i=0;i<8;++i)
            if(voices.at(i).note==note && voices.at(i).channel==channel)
            {
                voices.at(i).keyDown=false;
                if(!pedal.at(channel))voices.at(i).released=true;
            }
    }
    event midiIn(std::midi::Message message)
    {
        let channel=message.getChannel0to15();
        if(message.isNoteOn())noteOn(message.getNoteNumber(),channel,message.getFloatVelocity());
        if(message.isNoteOff())noteOff(message.getNoteNumber(),channel);
        if(message.getMessageType()==0xe0)
            channelBend.at(channel)=float(message.getPitchWheelValue()-8192)/8192.0f;
        if(message.getMessageType()==0xb0)
        {
            let control=message.getControllerNumber();
            if(control==64)
            {
                pedal.at(channel)=message.getControllerValue()>=64;
                if(!pedal.at(channel))for(int i=0;i<8;++i)
                    if(voices.at(i).channel==channel && !voices.at(i).keyDown)voices.at(i).released=true;
            }
            if(control==120 || control==123)
                for(int i=0;i<8;++i)if(voices.at(i).channel==channel)
                {
                    if(control==120)voices.at(i).silence();
                    else { voices.at(i).keyDown=false;voices.at(i).released=true; }
                }
        }
    }
    event modelCurve(MorphVoice::ModelCurve value) { for(int i=0;i<8;++i)voices.at(i).modelCurve(value); }
    event modelInfo(MorphVoice::ModelInfo value)
    {
        if(value.slot<0 || value.slot>1 || !(value.norm>0.0f))return;
        for(int i=0;i<8;++i)voices.at(i).modelInfo(value);
        modelReady <- value.slot;
    }
    void init()
    {
        let rate=float(processor.frequency);
        for(int i=0;i<8;++i)voices.at(i).setup(rate);
        outputLimiter.reset();updateLimiter();
        sendFX1.setup(rate,0,5.0f,1.0f);sendFX2.setup(rate,1,50.0f,10.0f);
        mainFX1.setup(rate,4,50.0f,50.0f);mainFX2.setup(rate,3,0.0f,50.0f);
    }
    float renderVoice(int index)
    {
        voices.at(index).oscillatorShape=oscillatorShape;
        voices.at(index).stretchAmount=stretchAmount;
        voices.at(index).releaseSeconds=releaseTime;
        voices.at(index).sustainSeconds=sustainTime;
        voices.at(index).keyTracking=keyTracking;
        voices.at(index).pitchBend=channelBend.at(voices.at(index).channel)*bendSemitones;
        voices.at(index).tonalRandom=tonalRandom;
        let sample=voices.at(index).render();
        tonalRandom=voices.at(index).tonalRandom;
        return sample;
    }
    void main()
    {
        loop
        {
            float sum=renderVoice(0);
            sum+=renderVoice(1);
            sum+=renderVoice(2);
            sum+=renderVoice(3);
            sum+=renderVoice(4);
            sum+=renderVoice(5);
            sum+=renderVoice(6);
            sum+=renderVoice(7);
            let sample=sum*gain;
            let dry=float<2>(sample,sample);
            if(!effectsPrimed)
            {
                // The native engine visits enabled wrappers once with a zero-length startup block.
                sendFX1.prepare();sendFX2.prepare();mainFX1.prepare();mainFX2.prepare();
                if(sendFX1.enabled)sendFX1.resume(roomSeed);if(sendFX2.enabled)sendFX2.resume(roomSeed);
                if(mainFX1.enabled)mainFX1.resume(tapeSeed);if(mainFX2.enabled)mainFX2.resume(tapeSeed);
                effectsPrimed=true;
            }
            sendFX1.tempo=tempoValue;sendFX2.tempo=tempoValue;
            var stereo=sendFX1.process(dry*sendAmount1,roomSeed)+dry;
            stereo=sendFX2.process(dry*sendAmount2,roomSeed)+stereo;
            stereo=mainFX1.process(stereo,tapeSeed);stereo=mainFX2.process(stereo,tapeSeed);

            out <- limiterEnabled?outputLimiter.process(stereo):stereo;
            advance();
        }
    }
}

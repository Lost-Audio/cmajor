        {
            let hz=(float(sin(float64((float(j)*0.01f+0.5f)*float(j))))*0.3f+float(startBin+j))/binScale;
            while(k<78 && hz>WaveData::hz.at(k+1))++k;
            let z=(hz-WaveData::hz.at(k))/(WaveData::hz.at(k+1)-WaveData::hz.at(k));
            highBand.at(j)=k;highLeft.at(j)=max(0.0f,1.0f-abs(z));highRight.at(j)=max(0.0f,1.0f-abs(1.0f-z));
            highGain.at(j)=sqrt(1.0f/(((1.0f-z)*WaveData::bandwidth.at(k)+z*WaveData::bandwidth.at(k+1))*binScale));
            initialNoise.at((lowCount+j)*2)=WaveData::initialSpectrum.at(startBin+j);
            initialNoise.at((lowCount+j)*2+1)=WaveData::initialSpectrum.at(128+startBin+j);
        }
        let x=(140.0f/rate*WaveData::k1fd830)/sqrt(10.0f),pa=shelfCurve(x),pb=shelfCurve(x*10.0f);
        shelfA=-pa;shelfB=((1.0f-pa)*10.0f)/(1.0f-pb);shelfC=-pb*shelfB;
        for(int i=0;i<256;++i)
        {
            var bits=i;int reversedBits=0;
            for(int j=0;j<8;++j){reversedBits=(reversedBits<<1)|(bits&1);bits>>=1;}
            reversed.at(i)=reversedBits;
            fftCos.at(i)=float(cos(float64(i)*6.283185307179586/256.0));
            fftSin.at(i)=float(sin(float64(i)*6.283185307179586/256.0));
        }

    float sq(float x) { return x*x; }
    float<2> rotate(float x)
    {
        x-=floor(x);let q=(1.0f-x)*x*4.0f;
        return float<2>(1.0f-(q*q*WaveData::k1fefc0+WaveData::k1fefec)*(q*q),
            ((q*WaveData::k1fefe0+WaveData::k1feff0)*q+WaveData::k1ff004)*((0.5f-x)*q));
    }
    float fused(float a,float b,float c) { return float(float64(a)*float64(b)+float64(c)); }
    float clockMapLog(float x)
    {
        let bits=std::intrinsics::reinterpretFloatToInt(x),mantissa=bits&0x7fffff,exponent=float((bits>>23)-127);
        let index=(mantissa>>16)+((mantissa>>15)&1);
        let a=std::intrinsics::reinterpretIntToFloat((index<<16)|0x3f000000),b=std::intrinsics::reinterpretIntToFloat(mantissa|0x3f000000);
        let r=(a-b)*WaveData::clockInverse.at(index),p=fused(WaveData::k2193b0,r,WaveData::k2193c0);
        let low=fused(WaveData::k219390,exponent,-fused(p,r*r,r)),high=fused(WaveData::k219380,exponent,WaveData::clockHigh.at(index));
        return high+(low+WaveData::clockLow.at(index));
    }
    float modelTime(float x) { return x<25.0f?x:clockMapLog(x/(WaveData::clockOffset*25.0f))/WaveData::clockLog; }
    float linearTime(float x) { return x<25.0f?x:float(exp(float64(WaveData::clockLog*x)))*(WaveData::clockOffset*25.0f); }
    float bandWindow(float x) { return sq(1.0f-((x-1.0f)*0.1f+1.0f)*(x*x)); }
    float shelfCurve(float x) { return (1.0f/((1.0f-x*WaveData::k1fbba4)+x*WaveData::k1fd81c*x)-1.0f)*WaveData::k1fd828+1.0f; }
    void init()
    {
        outputLimiter.reset();updateLimiter();
        times=CoreDefaults::time;stageTimes=times;
        frequencies=CoreDefaults::frequency;stageFrequencies=frequencies;
        norms=CoreDefaults::norm;durations=CoreDefaults::duration;tails=CoreDefaults::tail;
        let rate=float(processor.frequency),binScale=256.0f/rate,hopScale=64.0f/rate;
        while(lowCount<80 && WaveData::bandwidth.at(lowCount)<1.3f/binScale && WaveData::hz.at(lowCount)<rate*0.5f)++lowCount;
        let end=min(128,int(binScale*WaveData::k1ff050));
        startBin=lowCount<80?int(binScale*WaveData::hz.at(lowCount)+0.5f):end;
        highCount=end-startBin;voiceSize=lowCount+highCount;
        for(int i=0;i<80;++i)
        {
            let k=clamp(i-1,0,77),x=float(k-i),y=x+1.0f,z=x+2.0f;
            let p=hopScale*WaveData::hz.at(k),q=hopScale*WaveData::hz.at(k+1),r=hopScale*WaveData::hz.at(k+2),dy=q-p;
            let qa=((r-q)*x+(p-r)*y+dy*z)/((x-z)*(x-y)*(y-z));
            let qb=dy/(y-x)-(y+x)*qa,qc=(p-qa*x*x)-qb*x;
            frequencyPolynomial.at(i*3)=qc;frequencyPolynomial.at(i*3+1)=qb;frequencyPolynomial.at(i*3+2)=qa;
        }
        for(int i=0;i<lowCount;++i)
        {
            let hz=WaveData::hz.at(i),bw=WaveData::bandwidth.at(i),bin=binScale*hz;
            let k=int(bin),z=bin-float(k),g=float(pow(float64(1.0f-(1.0f-bw*binScale)*0.66f),float64(0.22f)));
            lowBin.at(i)=k;lowLeft.at(i)=bandWindow(z)*g;lowRight.at(i)=bandWindow(1.0f-z)*g;
            let rho=float(exp(float64(bw*WaveData::k1ff078*hopScale)))*0.5f;
            let rot=rotate(hopScale*hz),scale=1.0f/sqrt(rot[0]*rot[0]+rot[1]*rot[1]);
            noiseRe.at(i)=rot[0]*scale*rho;noiseIm.at(i)=rot[1]*scale*rho;noiseGain.at(i)=sqrt(1.0f-rho*rho);
            initialNoise.at(i*2)=z*WaveData::initialSpectrum.at(k+1)+(1.0f-z)*WaveData::initialSpectrum.at(k);
            let im0=k==0?0.0f:WaveData::initialSpectrum.at(128+k);
            initialNoise.at(i*2+1)=(1.0f-z)*im0+z*WaveData::initialSpectrum.at(129+k);
        }
        int k=max(0,lowCount-1);

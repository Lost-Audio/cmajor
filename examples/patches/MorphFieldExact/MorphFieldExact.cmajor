// Neutral single-track renderer traced from Visco 2.0.3.
// Native reference: 0x5d830, 0x63460, 0x53a60, and 0x53900.
processor MorphFieldExact [[ main ]]
{
    output stream float<2> out;
    input event float morph [[name:"Morph", min:0, max:1, init:0.5]];
    input event float level [[name:"Level", min:-36, max:6, init:0, unit:"dB"]];
    input event bool limiter [[name:"Limiter", init:false]];
    input event float limiterGain [[name:"Limiter Gain", min:0, max:48, init:0, unit:"dB"]];
    input event float limiterSpeed [[name:"Limiter Speed", min:0, max:100, init:50]];
    input event float audition;
    input event std::midi::Message midiIn;
    input event ModelCurve modelCurve;
    input event ModelInfo modelInfo;
    output event int modelReady;
    struct ModelCurve { int slot; int kind; int index; float[49] positions; }
    struct ModelInfo { int slot; float norm; float duration; float[7] tail; }
    struct Reader { int index; float width; float nextWidth; float base; float slope; float nextSlope; float quadratic; float shape; float sum; }
    Reader[8] readers;
    float[574] times,stageTimes;
    float[588] frequencies,stageFrequencies;
    float[2] norms,durations;
    float[14] tails;
    float[392] readA,readB;
    float[7] previousProgress,progress,speed;
    float[49] frequency;
    float[80] density,weights,tone,onset,share,freqTurns,timeTurns;
    float[240] frequencyPolynomial;
    float[80] lowLeft,lowRight,noiseGain,noiseRe,noiseIm;
    int[80] lowBin;
    int[128] highBand;
    float[128] highLeft,highRight,highGain;
    float[416] initialNoise,noise,phase,coupling,solved;
    float[208] a,b,mag,amplitude,noiseShare,turns,scratch;
    float[328] history;
    float[137] specRe,specIm;
    float[256] fftRe,fftIm,ola,fftCos,fftSin;
    int[256] reversed;
    float mix=0.5f,modelPosition,raw,velocityGain=1.0f,gain=1.0f;
    float shelfA,shelfB,shelfC,shelfState,delay1,delay2;
    int lowCount,highCount,startBin,voiceSize,historyIndex,historyCount,countdown,outIndex;
    int64 noiseSeed=2345L,tailSeed=123L;
    bool active,firstNoise;
    ViscoDynamics::Limiter outputLimiter;
    bool limiterEnabled;
    float limiterGainDb=0.0f,limiterSpeedValue=50.0f;

    event morph(float v) { mix=clamp(v,0.0f,1.0f); }
    event level(float db) { gain=pow(10.0f,clamp(db,-36.0f,6.0f)/20.0f); }
    event limiter(bool enabled) { limiterEnabled=enabled; }
    event limiterGain(float db) { limiterGainDb=clamp(db,0.0f,48.0f);updateLimiter(); }
    event limiterSpeed(float speed) { limiterSpeedValue=clamp(speed,0.0f,100.0f);updateLimiter(); }
    void updateLimiter() { outputLimiter.configure(float(processor.frequency),limiterGainDb,limiterSpeedValue); }
    event audition(float v) { if(v>0.0f)start(clamp(v,0.0f,1.0f)); }
    event midiIn(std::midi::Message m) { if(m.isNoteOn())start(m.getFloatVelocity()); }
    event modelCurve(ModelCurve c)
    {
        if(c.slot<0 || c.slot>1)return;
        if(c.kind==0 && c.index>=0 && c.index<7)
            for(int q=0;q<41;++q)stageTimes.at(c.slot*287+c.index*41+q)=c.positions.at(q);
        if(c.kind==1 && c.index>=0 && c.index<6)
            for(int q=0;q<49;++q)stageFrequencies.at(c.slot*294+c.index*49+q)=c.positions.at(q);
    }
    event modelInfo(ModelInfo m)
    {
        if(m.slot<0 || m.slot>1 || !(m.norm>0.0f))return;
        for(int q=0;q<287;++q)times.at(m.slot*287+q)=stageTimes.at(m.slot*287+q);
        for(int q=0;q<294;++q)frequencies.at(m.slot*294+q)=stageFrequencies.at(m.slot*294+q);
        for(int q=0;q<7;++q)tails.at(m.slot*7+q)=m.tail.at(q);
        norms.at(m.slot)=m.norm;durations.at(m.slot)=m.duration;
        active=false;modelReady <- m.slot;
    }

    float lerp(float a,float b,float t) { return (1.0f-t)*a+t*b; }
    float interval(int r,int i)
    {
        let k=r*49+i;
        return (readA.at(k+1)-readA.at(k))*(1.0f-(r==7?0.0f:mix))+
               (readB.at(k+1)-readB.at(k))*(r==7?0.0f:mix);
    }
    void resetReader(int r)
    {
        let w=interval(r,0);
        Reader s;
        s.index=-1;s.width=w;s.nextWidth=w;s.base=-w;s.nextSlope=1.0f/w;
        readers.at(r)=s;
    }
    float readCurve(int r,float x)
    {
        if(x<readA.at(r*49))return 0.0f;
        Reader s=readers.at(r);
        let count=r==7?49:41;
        while(s.index<count-1)
        {
            let w=s.width;
            if(x<s.base+w)break;
            s.base+=w;++s.index;
            s.sum=(w*s.quadratic+s.slope)*w+s.sum;
            s.slope=s.nextSlope;s.width=s.nextWidth;
            let intervalIndex=r*49+min(s.index+1,count-2);
            let amount=r==7?0.0f:mix;
            var next=(readA.at(intervalIndex+1)-readA.at(intervalIndex))*(1.0f-amount)
                    +(readB.at(intervalIndex+1)-readB.at(intervalIndex))*amount;
            if(r==7)next=max(next,1.0e-9f);
            s.nextWidth=next;
            let now=s.width;
            s.nextSlope=(next*next+now*now)/(next*now*(next+now));
            let shape=(0.5f/w+0.5f/next)*now;
            s.shape=(shape*shape-1.0f)*0.2f;
            s.quadratic=(s.nextSlope-(s.shape+1.0f)*s.slope)/((s.shape+2.0f)*now);
        }
        x-=s.base;
        let w=s.width;
        var numerator=(x*s.quadratic+s.slope)*((w*w)*x);
        var denominator=x*s.shape*(w-x)+w*w;
        if(r!=7){numerator=max(numerator,1.0e-30f);denominator=max(denominator,numerator*0.5f);}
        readers.at(r)=s;

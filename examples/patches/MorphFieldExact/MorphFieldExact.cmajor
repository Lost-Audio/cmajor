    }
    void reset()
    {
        modelPosition=0.0f;
        for(int r=0;r<7;++r)for(int q=0;q<41;++q)
        {
            readA.at(r*49+q)=times.at(r*41+q);
            readB.at(r*49+q)=times.at(287+r*41+q);
        }
        resetReader(0);resetReader(1);resetReader(2);resetReader(3);resetReader(4);resetReader(5);resetReader(6);
        for(int r=0;r<7;++r)previousProgress.at(r)=0.0f;
    }
    void advanceTime(int r,float delta)
    {
        let p=readCurve(r,modelPosition);
        speed.at(r)=clamp((p-previousProgress.at(r))*(1.0f/delta)-0.17585784196853638f,0.0f,20.0f);
        progress.at(r)=clamp(p*0.125f,0.0f,4.999000072479248f);
        previousProgress.at(r)=p;
    }
    void evaluate(float delta)
    {
        let oldTime=modelPosition;
        modelPosition+=delta;
        if(modelPosition<96.0f)
        {
            advanceTime(0,delta);advanceTime(1,delta);advanceTime(2,delta);advanceTime(3,delta);
            advanceTime(4,delta);advanceTime(5,delta);advanceTime(6,delta);
        }
        else
        {
            let step=(linearTime(modelPosition)-linearTime(oldTime))/689.0625f;
            for(int r=0;r<7;++r)
            {
                let tau=max(0.001f,(1.0f-mix)*tails.at(r)+mix*tails.at(7+r));
                speed.at(r)=(tau/(tau+step))*speed.at(r);
                tailSeed=(tailSeed^(tailSeed<<5))&0xffffffffL;tailSeed=tailSeed^(tailSeed>>7);
                progress.at(r)=clamp(progress.at(r)+(float(tailSeed)*2.3283000527563047e-10f-0.5f)*0.01f,3.999f,4.999f);
            }
        }
        for(int q=0;q<48;++q)
        {
            let r=q/8;
            let z=float(q%8)*0.125f;
            let u=(1.0f-z)*progress.at(r)+z*progress.at(r+1);
            let t=int(u),v=u-float(t);
            let lo=mix*frequencies.at(294+t*49+q)+(1.0f-mix)*frequencies.at(t*49+q);
            let hi=mix*frequencies.at(294+(t+1)*49+q)+(1.0f-mix)*frequencies.at((t+1)*49+q);
            frequency.at(q)=lo*(1.0f-v)+hi*v;
        }
        frequency.at(48)=80.0f;
        for(int q=0;q<49;++q){readA.at(343+q)=frequency.at(q);readB.at(343+q)=frequency.at(q);}
        resetReader(7);
        float previous=readCurve(7,0.0f);
        for(int band=0;band<80;++band)
        {
            let current=readCurve(7,float(band+1));density.at(band)=current-previous;previous=current;
        }
        frequency.at(48)=80.000999450683594f;
        int cell=0;
        let norm=velocityGain/max(0.000001f,sqrt(norms.at(0))*(1.0f-mix)+sqrt(norms.at(1))*mix);
        for(int band=0;band<80;++band)
        {
            while(cell<47 && frequency.at(cell+1)<float(band))++cell;
            let u=((float(band)-frequency.at(cell))/(frequency.at(cell+1)-frequency.at(cell))+float(cell))*0.125f;
            let r=clamp(int(u),0,5),z=u-float(r);
            weights.at(band)=((1.0f-z)*speed.at(r)+z*speed.at(r+1))*max(0.0f,density.at(band)-0.25220587849617004f)*norm;
        }

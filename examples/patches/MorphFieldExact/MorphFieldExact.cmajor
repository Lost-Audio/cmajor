    }
    void start(float v)
    {
        reset();raw=0.0f;historyCount=0;historyIndex=0;active=true;firstNoise=true;
        velocityGain=sqrt((v*127.0f)/100.0f);
        phase=float[416]();noise=float[416]();
    }
    void advanceModel()
    {
        raw+=raw==0.0f?1.0f:44100.0f/float(processor.frequency);
        evaluate(modelTime(raw)-modelPosition);
        let at=historyIndex*82;
        for(int i=0;i<80;++i)history.at(at+i+1)=weights.at(i)*weights.at(i);
        history.at(at)=max(history.at(at+1)*0.8f,history.at(at+1)*1.5f-history.at(at+2)*0.5f);
        history.at(at+81)=max(history.at(at+80)*0.8f,history.at(at+80)*1.5f-history.at(at+79)*0.5f);
        historyIndex=(historyIndex+1)%4;historyCount=min(4,historyCount+1);
    }
    void makeFeatures()
    {
        let old=((historyIndex+1)%4)*82,now=((historyIndex+2)%4)*82,next=((historyIndex+3)%4)*82;
        for(int i=0;i<79;++i)
        {
            let left=history.at(old+i)+history.at(now+i),mid=history.at(old+i+1)+history.at(now+i+1),right=history.at(old+i+2)+history.at(now+i+2);
            let oldPair=history.at(old+i+1)+history.at(old+i+2),nowPair=history.at(now+i+1)+history.at(now+i+2),nextPair=history.at(next+i+1)+history.at(next+i+2);
            let dx=(right-left)/((right+left)*WaveData::k1fefb4+mid*WaveData::k1fefd4+1.0e-30f);
            let inv=1.0f/(mid+left+right+1.0e-30f),u=mid*inv,z=abs(left-right)*inv;
            tone.at(i)=max(0.0f,(u*u-0.112f)*WaveData::k1ff000+(u-0.333f)*WaveData::k1ff00c+z*WaveData::k1feffc*z+WaveData::toneBias.at(i));
            let invT=1.0f/(nowPair+oldPair+nextPair+1.0e-30f),v=nowPair*invT,w=abs(oldPair-nextPair)*invT;
            onset.at(i)=max(0.0f,((v*v-0.112f)*WaveData::k1feff4+(v-0.333f)*WaveData::k1ff008+w*WaveData::k1feff8*w)*WaveData::onsetScale.at(i));
            share.at(i)=min(1.0f,onset.at(i)+tone.at(i));
            freqTurns.at(i)=(dx*frequencyPolynomial.at(i*3+2)+frequencyPolynomial.at(i*3+1))*dx+frequencyPolynomial.at(i*3);
            timeTurns.at(i)=((nextPair-oldPair)/((nextPair+oldPair)*WaveData::k1fefbc+nowPair*WaveData::k1fefdc+1.0e-30f))*WaveData::timeScale.at(i)*(-0.25f);
        }
        tone.at(79)=tone.at(78);onset.at(79)=onset.at(78);share.at(79)=share.at(78);freqTurns.at(79)=0.0f;timeTurns.at(79)=0.0f;
        amplitude=float[208]();
        for(int i=0;i<lowCount;++i)
        {
            a.at(i)=sq(max(tone.at(i)+0.3f,0.2f));b.at(i)=sq(max(onset.at(i)+0.4f,0.2f));
            timeTurns.at(i)-=floor(timeTurns.at(i));let rot=rotate(timeTurns.at(i));
            coupling.at(2*i)=rot[0];coupling.at(2*i+1)=rot[1];
            amplitude.at(i)=history.at(now+i+1);noiseShare.at(i)=1.0f-share.at(i);turns.at(i)=freqTurns.at(i);
        }
        let base=float(startBin)*0.25f;
        float bin=base;
        for(int j=0;j<highCount;++j)
        {
            let i=lowCount+j,k=highBand.at(j),w0=highLeft.at(j),w1=highRight.at(j);
            var value=(w0*history.at(now+k+1)+w1*history.at(now+k+2))*highGain.at(j);
            let tonal=w1*tone.at(k+1)+w0*tone.at(k),pitch=w1*freqTurns.at(k+1)+w0*freqTurns.at(k),timing=w1*onset.at(k+1)+w0*onset.at(k);
            a.at(i)=sq(max(tonal+0.3f,0.2f));b.at(i)=sq(max(timing+0.4f,0.2f));turns.at(i)=pitch;
            let shift=min(1.0f,max(0.0f,(abs(pitch-bin)-0.4f)*5.0f)*max(tonal,0.0f));
            if(shift>1.0e-9f)
            {
                let moved=value*shift,at=min((pitch-base)*4.0f,float(highCount)-WaveData::k1fc714),dest=max(0,int(at+float(lowCount))),frac=(at+float(lowCount))-float(dest);
                amplitude.at(dest)+=(1.0f-frac)*moved;amplitude.at(dest+1)+=frac*moved;value-=moved;
            }
            amplitude.at(i)=value+amplitude.at(i);noiseShare.at(i)=1.0f-(w1*share.at(k+1)+w0*share.at(k));
            let rot=rotate(w1*timeTurns.at(k+1)+w0*timeTurns.at(k));coupling.at(2*i)=rot[0];coupling.at(2*i+1)=rot[1];bin+=0.25f;
        }
        for(int i=0;i<voiceSize;++i)
        {
            mag.at(i)=sq(coupling.at(2*i))+sq(coupling.at(2*i+1));
            turns.at(i)-=floor(turns.at(i));let rot=rotate(turns.at(i)),re=phase.at(2*i),im=phase.at(2*i+1);
            let r=re*rot[0]-im*rot[1],v=re*rot[1]+im*rot[0];
            a.at(i)=min(1.0f,(r*r+v*v)*1.0e20f+0.001f)*a.at(i);
            phase.at(2*i)=r+1.0e-30f;phase.at(2*i+1)=v+1.0e-10f;
        }
    }
    void solvePhase()
    {
        solved.at(0)=a.at(0)*phase.at(0);solved.at(1)=a.at(0)*phase.at(1);scratch.at(0)=a.at(0);
        for(int i=1;i<voiceSize;++i)
        {
            let j=i-1,g=b.at(j)/(b.at(j)*mag.at(j)+scratch.at(j)+1.0e-30f),cr=g*coupling.at(2*j),ci=g*coupling.at(2*j+1);
            scratch.at(i)=g*scratch.at(j)+a.at(i);
            solved.at(2*i)=(solved.at(2*j)*cr-ci*solved.at(2*j+1))+a.at(i)*phase.at(2*i);
            solved.at(2*i+1)=(ci*solved.at(2*j)+cr*solved.at(2*j+1))+a.at(i)*phase.at(2*i+1);
        }
        let last=voiceSize-1,scale=1.0f/(scratch.at(last)+1.0e-30f);solved.at(2*last)*=scale;solved.at(2*last+1)*=scale;
        for(int i=voiceSize-2;i>=0;--i)
        {
            let k=2*i,g=b.at(i),cr=g*coupling.at(k),ci=-coupling.at(k+1)*g,scaleBack=1.0f/(g*mag.at(i)+scratch.at(i)+1.0e-30f);
            solved.at(k)=((cr*solved.at(k+2)-ci*solved.at(k+3))+solved.at(k))*scaleBack;
            solved.at(k+1)=((ci*solved.at(k+2)+cr*solved.at(k+3))+solved.at(k+1))*scaleBack;
        }
    }
    void addNoise()
    {
        noiseSeed=(noiseSeed*1664525L+1013904223L)&0xffffffffL;
        let at=int(noiseSeed%int64(2048-voiceSize))*2;
        if(firstNoise){noise=initialNoise;firstNoise=false;}
        else
        {
            for(int i=0;i<lowCount;++i)
            {
                let r=noise.at(2*i),v=noise.at(2*i+1),cr=noiseRe.at(i),ci=noiseIm.at(i),g=noiseGain.at(i);
                noise.at(2*i)=(r*cr-v*ci)+g*WaveData::noiseTable.at(at+2*i);
                noise.at(2*i+1)=(r*ci+v*cr)+g*WaveData::noiseTable.at(at+2*i+1);
            }
            for(int i=lowCount;i<voiceSize;++i){noise.at(2*i)=WaveData::noiseTable.at(at+2*i);noise.at(2*i+1)=WaveData::noiseTable.at(at+2*i+1);}
        }
        for(int i=0;i<voiceSize;++i)
        {
            let amp=amplitude.at(i),na=amp*noiseShare.at(i),r=solved.at(2*i),v=solved.at(2*i+1),scale=(na+amp)/(sqrt(r*r+v*v)+na+1.0e-30f);
            phase.at(2*i)=na*noise.at(2*i)+scale*r;phase.at(2*i+1)=scale*v+na*noise.at(2*i+1);
        }
    }
    void inverseFFT()
    {
        for(int i=0;i<256;++i){fftRe.at(i)=0.0f;fftIm.at(i)=0.0f;}
        specRe.at(4)+=specRe.at(4);specIm.at(4)=0.0f;
        for(int i=1;i<=4;++i){specRe.at(i+4)+=specRe.at(4-i);specIm.at(i+4)-=specIm.at(4-i);}
        for(int i=0;i<128;++i){fftRe.at(i)=specRe.at(i+4);fftIm.at(i)=specIm.at(i+4);}
        for(int i=1;i<128;++i){fftRe.at(256-i)=fftRe.at(i);fftIm.at(256-i)=-fftIm.at(i);}
        for(int i=0;i<256;++i)if(i<reversed.at(i))
        {
            let j=reversed.at(i),r=fftRe.at(i),v=fftIm.at(i);fftRe.at(i)=fftRe.at(j);fftIm.at(i)=fftIm.at(j);fftRe.at(j)=r;fftIm.at(j)=v;
        }
        for(int size=2;size<=256;size*=2)for(int j=0;j<size/2;++j)
        {
            let c=fftCos.at(j*256/size),s=fftSin.at(j*256/size);
            for(int k=j;k<256;k+=size)
            {
                let b=k+size/2,x=fftRe.at(b)*c-fftIm.at(b)*s,y=fftRe.at(b)*s+fftIm.at(b)*c,r=fftRe.at(k),v=fftIm.at(k);
                fftRe.at(k)=r+x;fftIm.at(k)=v+y;fftRe.at(b)=r-x;fftIm.at(b)=v-y;
            }
        }
    }
    void makeSpectrum()
    {
        specRe=float[137]();specIm=float[137]();
        // Native neutral single-voice processing submits the spectrum twice.
        loop(2)
        {
            for(int i=0;i<lowCount;++i)
            {
                let k=lowBin.at(i)+4,l=lowLeft.at(i),r=lowRight.at(i),re=phase.at(2*i),im=phase.at(2*i+1);
                specRe.at(k)+=re*l;specRe.at(k+1)+=re*r;specIm.at(k)+=im*l;specIm.at(k+1)+=im*r;
            }
            for(int j=0;j<highCount;++j){let k=startBin+j+4;specRe.at(k)+=phase.at(2*(lowCount+j));specIm.at(k)+=phase.at(2*(lowCount+j)+1);}
        }
        inverseFFT();
        for(int i=0;i<256;++i)ola.at((outIndex+i)%256)+=fftRe.at((i+128)%256)*WaveData::olaWindow.at(i);
    }
    void tick()
    {
        let duration=max(durations.at(0),durations.at(1));
        if((duration<95.0f && duration+1.0f<modelPosition)||duration<1.0f){active=false;return;}
        advanceModel();while(historyCount<3)advanceModel();
        makeFeatures();solvePhase();addNoise();makeSpectrum();
        if(modelPosition>=96.0f)
        {
            float peak=0.0f;for(int i=0;i<7;++i)peak=max(peak,speed.at(i));
            if(peak*peak<0.00001f)active=false;
        }
    }
    void main()
    {
        loop
        {
            if(countdown==0){if(active)tick();countdown=64;}--countdown;
            let inputSample=ola.at(outIndex);ola.at(outIndex)=0.0f;outIndex=(outIndex+1)%256;
            let x=inputSample-shelfState*shelfA,y=shelfState*shelfC+x*shelfB;shelfState=x;
            let sample=delay2*gain;delay2=delay1;delay1=y;
            let stereo=float<2>(sample,sample);
            out <- limiterEnabled?outputLimiter.process(stereo):stereo;advance();
        }
    }
}

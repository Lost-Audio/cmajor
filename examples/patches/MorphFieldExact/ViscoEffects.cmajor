    float log2Fast(float x)
    {
        let bits=std::intrinsics::reinterpretFloatToInt(x);
        let m=std::intrinsics::reinterpretIntToFloat((bits&0x7fffff)|0x3f800000);
        return ((((0.6480233669281006f-m*0.08193954080343246f)*m-2.1291816234588623f)*m+4.080473899841309f)*m-2.51737642288208f)+float(((bits>>23)&255)-127);
    }
    float exp2Fast(float x)
    {
        let z=x+127.0f,index=int(z),t=z-float(index);
        return ((((t*0.013686471618711948f+0.051752276718616486f)*t+0.24156560003757477f)*t+0.6929956674575806f)*t+1.0f)*pow(2.0f,float(index-127));
    }
    float gainDb(float db) { return exp2Fast(db*0.16609638929367065f); }
    float smoothCoefficient(float frames) { return 1.0f-(frames*frames)/(frames+1.0f+frames*frames); }
    float saturate(float x) { let a=abs(x),p=(a+1.0f)*a+1.0f;return (x*p)/(p*a+1.0f); }
    float peak(float<2> x) { return max(max(abs(x[0]),0.00009999999747378752f),abs(x[1])); }

    // Sticky Compressor, RVA 0xdae20.
    struct Sticky
    {
        float envelope,attack,release,threshold,makeup;
        void reset() { this.envelope=0.0f; }
        void configure(float rate,float gain,float speed)
        {
            let s=1.0f-(speed/100.0f)*0.9800000190734863f,t=s*s,base=rate*0.0005000000237487257f;
            this.attack=smoothCoefficient(t*0.019999999552965164f*rate+base);
            this.release=smoothCoefficient(t*0.20000000298023224f*rate+base);
            this.makeup=gain*0.16609638929367065f;
            this.threshold=(-10.0f-gain*1.3329999446868896f)*0.16609638929367065f;
        }
        float<2> process(float<2> x)
        {
            let target=min(0.0f,this.threshold-log2Fast(peak(x)))*0.6666666269302368f+this.makeup;
            this.envelope=((target<this.envelope?this.attack-this.release:0.0f)+this.release)*(target-this.envelope)+this.envelope;
            let y=x*exp2Fast(this.envelope);return float<2>(saturate(y[0]),saturate(y[1]));
        }
    }
    // L.A. Optical, RVA 0xdb9c0.
    struct Optical
    {
        float detector,envelope,release,attackDelta,numerator,offset;
        void reset() { this.detector=1.0f;this.envelope=1.0f; }
        void configure(float rate,float gain,float speed)
        {
            let s=speed/100.0f;
            this.release=1.0f/((400.0f-s*395.0f)*0.001f*rate+1.0f);
            this.attackDelta=1.0f/((8.0f-s*6.0f)*0.001f*rate+1.0f)-this.release;
            this.numerator=exp2Fast((-gain*0.25f)*0.16609638929367065f);
            this.offset=this.numerator/gainDb(gain);
        }
        float<2> process(float<2> x)
        {
            let a=(1.0f-(x[0]<0.0f?1.7999999523162842f:0.0f))*x[0];
            let b=(1.0f-(x[1]<0.0f?1.7999999523162842f:0.0f))*x[1];
            let p=max(a,b)+0.00009999999747378752f;
            this.detector=((this.detector<p?0.10000000149011612f:0.0f)+0.009999999776482582f)*(p-this.detector)+this.detector;
            let d=this.numerator/(this.detector+this.offset)-this.envelope;
            this.envelope=(abs(d)+0.10000000149011612f)*((d<0.0f?this.attackDelta:0.0f)+this.release)*d+this.envelope;
            return x*this.envelope;
        }
    }
    // Upward Compressor, RVA 0xdc9e0.
    struct Upward
    {
        float detector,envelope,attack,release,slope,threshold,offset;
        void reset() { this.detector=0.0f;this.envelope=0.0f; }
        void configure(float rate,float ratio,float speed)
        {
            this.slope=1.0f-1.0f/ratio;
            let frames=(1.0f-speed/100.0f)*0.20000000298023224f*rate;
            this.attack=smoothCoefficient((this.slope>=0.0f?0.1f:1.0f)*frames+3.0f);
            this.release=smoothCoefficient((this.slope>=0.0f?1.0f:0.1f)*frames+3.0f);
            this.threshold=(min(0.0f,this.slope*(-10.0f))-12.0f)*0.16609638929367065f;
            this.offset=max(0.0f,1.0f-ratio);
        }
        float<2> process(float<2> x)
        {
            this.detector=max(this.detector*0.9900000095367432f,peak(x));
            let level=log2Fast(this.detector),target=max(0.0f,(this.threshold-this.offset)-level)*this.slope+this.offset;
            let value=((target<this.envelope?this.attack-this.release:0.0f)+this.release)*(target-this.envelope)+this.envelope;
            this.envelope=min(value,-level);return x*exp2Fast(this.envelope);
        }
    }
    // Send Compressor, RVA 0xdcfe0.
    struct Compressor
    {
        float envelope,attack,release,slope;
        void reset() { this.envelope=0.0f; }
        void configure(float rate,float ratio,float speed)
        {
            let s=1.0f-(speed/100.0f)*0.8999999761581421f;
            let frames=s*s*0.20000000298023224f*rate;
            this.release=smoothCoefficient(frames);
            this.attack=smoothCoefficient(frames*0.05000000074505806f+rate*0.0005000000237487257f);
            this.slope=1.0f-1.0f/ratio;
        }
        float<2> process(float<2> x)
        {
            let level=log2Fast(peak(x)),target=(-15.0f*0.16609638929367065f-level)*this.slope;
            let value=((target<this.envelope?this.attack-this.release:0.0f)+this.release)*(target-this.envelope)+this.envelope;
            this.envelope=min(value,-level);let y=x*exp2Fast(this.envelope);
            return float<2>(saturate(y[0]),saturate(y[1]));
        }
    }
    // Transformer Amp, RVA 0xdcd60.
    struct Transformer
    {
        float<2> envelope;
        float positive,negative,inverseGain;
        void reset() { this.envelope=float<2>(1.0f,0.0f); }
        void configure(float rate,float gain,float bias)
        {
            let g=gainDb(gain),b=abs(bias/100.0f),base=(g*0.5f)/(g*0.25f+1.0f)+0.5f;
            let a=base/(1.0499999523162842f-b),c=(1.0f-b*0.6000000238418579f)*base;
            this.positive=bias<0.0f?c:a;this.negative=-(bias<0.0f?a:c);this.inverseGain=1.0f/g;
        }
        float<2> process(float<2> x)
        {
            float<2> y;
            for(int ch=0;ch<2;++ch){let target=1.0f/((x[ch]>0.0f?this.positive:this.negative)*x[ch]+this.inverseGain);this.envelope[ch]=(target-this.envelope[ch])*0.5f+this.envelope[ch];y[ch]=saturate(this.envelope[ch]*x[ch]);}
            return y;
        }
    }
    // Stereo Fuzz, RVA 0xdd370. Native coefficient changes occur at block boundaries.
    struct Fuzz
    {
        float<2> low,velocity;
        float rate,drive,color,coefficient,damping,coefficientStep,dampingStep,denominator,asymmetry;
        int cursor;
        void reset() { this.low=0.0f;this.velocity=0.0f;this.coefficient=0.0f;this.damping=0.0f;this.cursor=0; }
        void configure(float rate,float drive,float color) { this.rate=rate;this.drive=drive;this.color=color; }
        void beginBlock(int count)
        {
            let c=this.color/100.0f,d=1.0f-(this.drive/100.0f)*0.9200000166893005f;
            let t=c*0.699999988079071f+0.30000001192092896f,f=(t*t*t*3000.0f)/this.rate;
            this.denominator=(1.0f/(c*0.5f+0.20000000298023224f))*(d*d);
            this.asymmetry=1.0f/(d*d+0.10000000149011612f);
            let step=1.0f/max(this.rate*0.009999999776482582f,float(count));
            this.coefficientStep=((f*f)/(f*f*0.5f+0.02500000037252903f)-this.coefficient)*step;
            this.dampingStep=((1.0f-f/(f+0.10000000149011612f))-this.damping)*step;
        }
        float<2> process(float<2> x)
        {
            if(this.cursor==0)this.beginBlock(64);
            float<2> y;
            for(int ch=0;ch<2;++ch){let v=(this.damping*this.velocity[ch]+x[ch])-this.low[ch];this.velocity[ch]=v;this.low[ch]=v*this.coefficient+this.low[ch];y[ch]=(1.0f/((v>0.0f?this.asymmetry+this.asymmetry:-this.asymmetry)*v+this.denominator))*v;}
            this.coefficient+=this.coefficientStep;this.damping+=this.dampingStep;this.cursor=(this.cursor+1)%64;return y;
        }
    }
    struct TapeRandom
    {
        float phase,a,b,c;
        float next(float step,int64& seed)
        {
            this.phase+=step;
            if(this.phase>=1.0f){this.a=this.b;this.b=this.c;seed=(seed*1664525L+1013904223L)&0xffffffffL;this.c=float(seed)*2.3283000527563047e-10f;this.phase-=float(int(this.phase));}
            let p=this.phase,q=p*p;
            return (((p-q)+(p-q)+1.0f)*this.b+q*this.c+((1.0f-(p+p))+q)*this.a)*0.5f;
        }
    }
    struct TapeChannel
    {
        float low,velocity,post,postVelocity,envelope,feedback,cutoff,shelf;
        float feedbackStep,cutoffStep,shelfStep;
        TapeRandom wobble,bias;
        void reset() { this=();this.envelope=1.0f; }
        void beginBlock(float rate,float age,int count,int64& seed)
        {
            let f=min(1.0f,5000.0f/rate),step=min(1.0f,(float(count)/rate)*3.0f);
            let target=(this.wobble.next(step,seed)-0.5f)*f*age+f;
            let colour=this.bias.next(step,seed)-0.800000011920929f;
            this.cutoffStep=(target-this.cutoff)/float(count);
            this.feedbackStep=(1.0f/(target*4.0f+1.0f)-this.feedback)/float(count);
            this.shelfStep=((colour*(age*0.25f)+0.25f)-this.shelf)/float(count);
        }
        float process(float x,float drive,float age,float postA,float postB)
        {
            let v=(this.feedback*this.velocity+x)-this.low;this.velocity=v;
            this.low=v*this.cutoff+this.low;
            var y=v*this.shelf+this.low;
            let a=drive+drive+0.5f,b=1.0f-drive*0.8999999761581421f,c=age*drive*age;
            let distorted=y/(abs(y)*a+b+y*c*y);
            let previous=this.postVelocity,v2=(distorted-this.post)*postB;this.postVelocity=v2;
            y=(v2+this.post)-postA*previous;this.post=distorted-v2*0.25f;
            let target=1.0f/(abs(y)*a+b);
            this.envelope=((target<this.envelope?0.5999999642372131f:0.0f)+0.10000000149011612f)*(target-this.envelope)+this.envelope;
            this.feedback+=this.feedbackStep;this.cutoff+=this.cutoffStep;this.shelf+=this.shelfStep;
            return this.envelope*y;
        }
    }
    // Tape Simulator, RVA 0xdc120. The random seed is shared by both channels.
    struct Tape
    {
        TapeChannel left,right;
        float rate,drive,age,postA,postB;
        int cursor;int64 seed;
        void reset() { this.left.reset();this.right.reset();this.cursor=0;this.seed=2345L; }
        void configure(float rate,float drive,float age)
        {
            this.rate=rate;this.drive=clamp(drive/100.0f,0.0f,1.0f);this.age=clamp(age/100.0f,0.0f,1.0f);
            let f=min(1.0f,5000.0f/rate);this.postA=1.0f/(f*4.0f+1.0f);this.postB=1.0f/(f+0.25f);
        }
        float<2> process(float<2> x)
        {
            if(this.cursor==0){this.left.beginBlock(this.rate,this.age,64,this.seed);this.right.beginBlock(this.rate,this.age,64,this.seed);}
            this.cursor=(this.cursor+1)%64;
            return float<2>(this.left.process(x[0],this.drive,this.age,this.postA,this.postB),this.right.process(x[1],this.drive,this.age,this.postA,this.postB));
        }
        float<2> processShared(float<2> x,int64& seed) { this.seed=seed;let y=this.process(x);seed=this.seed;return y; }
    }

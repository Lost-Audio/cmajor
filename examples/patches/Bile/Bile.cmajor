/**
    Bile - a gross acid bass.

    A monophonic saw or square through a four-pole ladder filter that can scream into
    self-oscillation, hit by an envelope that accents push harder, then driven and
    folded until it gurgles, and thrown into a dotted ping-pong echo.

    Overlapping notes glide into each other instead of retriggering, so slides work from
    MIDI as well as from the built-in sequencer, where each of the 16 steps has a note,
    an accent and a slide. In a host, the sequencer follows its tempo, and while Run is
    on it plays only when the host is playing, locked to the host's beat position.
*/

graph Bile  [[main]]
{
    input event std::midi::Message midiIn;
    input event std::timeline::Tempo tempoIn;
    input event std::timeline::TransportState transportIn;
    input event std::timeline::Position positionIn;
    output stream float<2> out;
    output event int currentStep;
    output event float noteHit;

    input value int   wave        [[ name: "Wave",         min: 0,     max: 1,     init: 0,     text: "Saw|Square" ]];
    input value float cutoff      [[ name: "Cutoff",       min: 30,    max: 5000,  init: 260,   unit: "Hz" ]];
    input value float resonance   [[ name: "Resonance",    min: 0,     max: 1,     init: 0.85 ]];
    input value float envMod      [[ name: "Env Mod",      min: 0,     max: 1,     init: 0.7 ]];
    input value float decay       [[ name: "Decay",        min: 0.05,  max: 2,     init: 0.3,   unit: "s" ]];
    input value float accent      [[ name: "Accent",       min: 0,     max: 1,     init: 0.8 ]];
    input value float glide       [[ name: "Glide",        min: 0.01,  max: 0.5,   init: 0.1,   unit: "s" ]];

    input value float drive       [[ name: "Drive",        min: 0,     max: 1,     init: 0.65 ]];
    input value float grit        [[ name: "Grit",         min: 0,     max: 1,     init: 0.35 ]];
    input value float space       [[ name: "Space",        min: 0,     max: 1,     init: 0.3 ]];

    input value int   run         [[ name: "Run",          min: 0,     max: 1,     init: 0,     text: "Stop|Run" ]];
    input value float bpm         [[ name: "BPM",          min: 100,   max: 180,   init: 140,   step: 1 ]];
    input value float root        [[ name: "Root",         min: 24,    max: 60,    init: 36,    step: 1, unit: "note" ]];
    input value int   pattern     [[ name: "Pattern",      min: 0,     max: 65535, init: 48603 ]];
    input value int   accents     [[ name: "Accents",      min: 0,     max: 65535, init: 9353 ]];
    input value int   slides      [[ name: "Slides",       min: 0,     max: 65535, init: 11338 ]];

    // each step's note, in semitones from the root
    input value int   note1       [[ name: "Step 1 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note2       [[ name: "Step 2 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note3       [[ name: "Step 3 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note4       [[ name: "Step 4 Note", min: -24, max: 24, init: 12, step: 1, hidden: true ]];
    input value int   note5       [[ name: "Step 5 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note6       [[ name: "Step 6 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note7       [[ name: "Step 7 Note", min: -24, max: 24, init: 3, step: 1, hidden: true ]];
    input value int   note8       [[ name: "Step 8 Note", min: -24, max: 24, init: 15, step: 1, hidden: true ]];
    input value int   note9       [[ name: "Step 9 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note10      [[ name: "Step 10 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note11      [[ name: "Step 11 Note", min: -24, max: 24, init: 7, step: 1, hidden: true ]];
    input value int   note12      [[ name: "Step 12 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note13      [[ name: "Step 13 Note", min: -24, max: 24, init: 12, step: 1, hidden: true ]];
    input value int   note14      [[ name: "Step 14 Note", min: -24, max: 24, init: 10, step: 1, hidden: true ]];
    input value int   note15      [[ name: "Step 15 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];
    input value int   note16      [[ name: "Step 16 Note", min: -24, max: 24, init: 0, step: 1, hidden: true ]];

    input value float volume      [[ name: "Volume",       min: -36,   max: 6,     init: -1,    unit: "dB" ]];

    node
    {
        sequencer = Sequencer;
        voice     = AcidVoice;
        echo      = Echo;
    }

    connection
    {
        midiIn -> std::midi::MPEConverter -> voice.eventIn;
        sequencer.noteOut -> voice.eventIn;

        tempoIn     -> sequencer.tempoIn;
        transportIn -> sequencer.transportIn;
        positionIn  -> sequencer.positionIn;
        run         -> sequencer.run;
        bpm         -> sequencer.bpm;
        root        -> sequencer.root;
        pattern     -> sequencer.pattern;
        accents     -> sequencer.accents;
        slides      -> sequencer.slides;
        note1       -> sequencer.notes[0];
        note2       -> sequencer.notes[1];
        note3       -> sequencer.notes[2];
        note4       -> sequencer.notes[3];
        note5       -> sequencer.notes[4];
        note6       -> sequencer.notes[5];
        note7       -> sequencer.notes[6];
        note8       -> sequencer.notes[7];
        note9       -> sequencer.notes[8];
        note10      -> sequencer.notes[9];
        note11      -> sequencer.notes[10];
        note12      -> sequencer.notes[11];
        note13      -> sequencer.notes[12];
        note14      -> sequencer.notes[13];
        note15      -> sequencer.notes[14];
        note16      -> sequencer.notes[15];
        sequencer.stepOut -> currentStep;

        wave        -> voice.wave;
        cutoff      -> voice.cutoff;
        resonance   -> voice.resonance;
        envMod      -> voice.envMod;
        decay       -> voice.decay;
        accent      -> voice.accent;
        glide       -> voice.glide;
        drive       -> voice.drive;
        grit        -> voice.grit;
        voice.hitOut -> noteHit;

        sequencer.tempoOut -> echo.bpm;
        space       -> echo.mix;
        volume      -> echo.volume;

        voice.out -> echo.in;
        echo.out -> out;
    }
}

//==============================================================================
namespace bile
{
    /// Returns a per-sample multiplier that makes an envelope fall by 60dB over the given time
    float decayCoefficient (float seconds, float64 sampleRate)
    {
        return float (exp (-6.9 / (float64 (max (seconds, 0.001f)) * sampleRate)));
    }

    /// The correction that takes the aliasing step out of a naive sawtooth or square
    float polyBLEP (float phase, float increment)
    {
        if (phase < increment)
        {
            let t = phase / increment;
            return t + t - t * t - 1.0f;
        }

        if (phase > 1.0f - increment)
        {
            let t = (phase - 1.0f) / increment;
            return t * t + t + t + 1.0f;
        }

        return 0.0f;
    }
}

//==============================================================================
// A 16-step acid sequencer. Each set bit in `pattern` plays a note, `notes` holds each
// step's note as semitones from `root`, a set bit in `accents` hits it harder, and a set
// bit in `slides` holds the note into the next step, so the voice glides there instead
// of retriggering. Notes that don't slide are released halfway through their step.
processor Sequencer
{
    input event std::timeline::Tempo tempoIn;
    input event std::timeline::TransportState transportIn;
    input event std::timeline::Position positionIn;
    input value int run;
    input value float bpm;
    input value float root;
    input value int pattern;
    input value int accents;
    input value int slides;
    input value int notes[16];

    output event (std::notes::NoteOn, std::notes::NoteOff) noteOut;
    output event int stepOut;
    output value float tempoOut;

    event tempoIn (std::timeline::Tempo t)
    {
        if (t.bpm > 0.0f)
        {
            hostTempo = t.bpm;
            hasHostTempo = true;
        }
    }

    // Once a host has told us about its transport, Run only plays while the host does.
    // A standalone player never sends one, so there Run alone starts and stops it.
    event transportIn (std::timeline::TransportState t)
    {
        hasHostTransport = true;
        isHostPlaying = t.isPlaying();
    }

    event positionIn (std::timeline::Position p)
    {
        hostSixteenths = p.quarterNote * 4.0;
        hasNewPosition = true;
    }

    let sequencerChannel = 200;

    float hostTempo;
    bool hasHostTempo, hasHostTransport, isHostPlaying, hasNewPosition;
    float64 hostSixteenths;

    void main()
    {
        float64 sixteenths;   // position in 16th notes; each whole number is a step
        int64 lastIndex;
        bool isNoteOn, wasRunning, isSliding;
        float lastPitch;

        loop
        {
            let tempo = hasHostTempo ? hostTempo : bpm;
            tempoOut <- tempo;

            let shouldPlay = run != 0 && (! hasHostTransport || isHostPlaying);

            if (hasHostTransport && hasNewPosition)
            {
                sixteenths = hostSixteenths;
                hasNewPosition = false;
            }

            if (shouldPlay)
            {
                if (! wasRunning)
                {
                    wasRunning = true;

                    if (! hasHostTransport)
                        sixteenths = 0;

                    // start on the step we're at if it's exactly on it, otherwise wait for the next one
                    lastIndex = int64 (ceil (sixteenths)) - 1;
                }

                let index = int64 (floor (sixteenths));

                // the host's position can nudge us back a hair, which mustn't retrigger a step,
                // but a bigger jump backwards (a loop, or relocating) starts from there
                if (index > lastIndex || index < lastIndex - 1)
                {
                    lastIndex = index;
                    let step = int (((index % 16) + 16) % 16);
                    stepOut <- step;

                    let isGate = ((pattern >> step) & 1) != 0;
                    let wasHeld = isNoteOn;
                    let previousPitch = lastPitch;
                    let isSlidingIn = wasHeld && isSliding && isGate;

                    if (wasHeld && ! isSlidingIn)
                    {
                        noteOut <- std::notes::NoteOff (sequencerChannel, previousPitch, 0.0f);
                        isNoteOn = false;
                    }

                    if (isGate)
                    {
                        let isAccent = ((accents >> step) & 1) != 0;
                        lastPitch = root + float (notes[wrap<16> (step)]);
                        noteOut <- std::notes::NoteOn (sequencerChannel, lastPitch, isAccent ? 1.0f : 0.7f);

                        // a slide: the new note overlaps the old one, then the old one lets go
                        if (isSlidingIn)
                            noteOut <- std::notes::NoteOff (sequencerChannel, previousPitch, 0.0f);

                        isNoteOn = true;
                        isSliding = ((slides >> step) & 1) != 0;
                    }
                    else
                    {
                        isSliding = false;
                    }
                }
                else if (isNoteOn && ! isSliding && sixteenths - float64 (index) >= 0.5)
                {
                    noteOut <- std::notes::NoteOff (sequencerChannel, lastPitch, 0.0f);
                    isNoteOn = false;
                }
            }
            else if (wasRunning)
            {
                wasRunning = false;
                isSliding = false;
                stepOut <- -1;

                if (isNoteOn)
                {
                    noteOut <- std::notes::NoteOff (sequencerChannel, lastPitch, 0.0f);
                    isNoteOn = false;
                }
            }

            sixteenths += float64 (max (tempo, 20.0f)) * (4.0 / 60.0) * processor.period;
            advance();
        }
    }
}

//==============================================================================
// The monosynth. A note that arrives while another is held glides to the new pitch
// without retriggering anything; letting go of it glides back to the last note still held.
processor AcidVoice
{
    input event (std::notes::NoteOn, std::notes::NoteOff) eventIn;
    input value int wave;
    input value float cutoff;
    input value float resonance;
    input value float envMod;
    input value float decay;
    input value float accent;
    input value float glide;
    input value float drive;
    input value float grit;

    output stream float out;
    output event float hitOut;   // each note that plays or slides, with its accent, for the GUI

    int[128] heldCount, heldOrder;
    int numHeld, orderCounter;

    float pitch = 36.0f, targetPitch = 36.0f;
    bool isGateOn;
    float filterEnv, accentEnv, accentSweep, isAccented;

    event eventIn (std::notes::NoteOn n)
    {
        let note = wrap<128> (clamp (int (n.pitch + 0.5f), 0, 127));
        let isLegato = numHeld > 0;

        ++heldCount[note];
        ++numHeld;
        ++orderCounter;
        heldOrder[note] = orderCounter;
        targetPitch = n.pitch;

        let isAccent = n.velocity > 0.85f;
        isAccented = isAccent ? 1.0f : 0.0f;

        if (! isLegato)
        {
            pitch = n.pitch;
            isGateOn = true;
            filterEnv = 1.0f;
        }

        if (isAccent)
            accentEnv = 1.0f;

        hitOut <- isAccent ? 1.0f : 0.6f;
    }

    event eventIn (std::notes::NoteOff n)
    {
        let note = wrap<128> (clamp (int (n.pitch + 0.5f), 0, 127));

        if (heldCount[note] == 0)
            return;

        --heldCount[note];
        --numHeld;

        if (heldCount[note] == 0)
            heldOrder[note] = 0;

        if (numHeld == 0)
        {
            isGateOn = false;
            return;
        }

        // glide back to the most recently pressed note that's still down
        int newest = 0;

        for (wrap<128> i)
        {
            if (heldOrder[i] > newest)
            {
                newest = heldOrder[i];
                targetPitch = float (int (i));
            }
        }
    }

    void main()
    {
        float phase, amp;
        float y1, y2, y3, y4;
        float dcIn, dcOut;

        loop
        {
            let fs = float (processor.frequency);

            pitch += (targetPitch - pitch) * (1.0f - exp (-3.0f / (glide * fs)));
            let increment = min (std::notes::noteToFrequency (pitch) / fs, 0.45f);

            phase += increment;

            if (phase >= 1.0f)
                phase -= 1.0f;

            var osc = 0.0f;

            if (wave == 0)
            {
                osc = 2.0f * phase - 1.0f - bile::polyBLEP (phase, increment);
            }
            else
            {
                let shifted = phase + 0.5f >= 1.0f ? phase - 0.5f : phase + 0.5f;
                osc = (phase < 0.5f ? 1.0f : -1.0f) + bile::polyBLEP (phase, increment) - bile::polyBLEP (shifted, increment);
            }

            // accents make the filter envelope shorter and bigger, and the sweep builds up over
            // consecutive accents because it is smoothed rather than following the hits directly
            filterEnv *= bile::decayCoefficient (isAccented > 0.5f ? min (decay, 0.2f) : decay, processor.frequency);
            accentEnv *= bile::decayCoefficient (0.25f, processor.frequency);
            accentSweep += (accentEnv - accentSweep) * (1.0f - exp (-1.0f / (0.04f * fs)));

            let sweep = envMod * filterEnv * (4.5f + 2.0f * accent * isAccented) + accent * accentSweep * 2.5f;
            let cutoffHz = min (cutoff * pow (2.0f, sweep), 0.2f * fs);

            amp += ((isGateOn ? 1.0f : 0.0f) - amp) * (1.0f - exp (-1.0f / ((isGateOn ? 0.002f : 0.008f) * fs)));

            // a four-pole ladder with a saturating stage at each pole, run at twice the sample rate
            let g = 1.0f - exp (-float (twoPi) * cutoffHz / (2.0f * fs));
            let k = resonance * 4.3f;

            for (int pass = 0; pass < 2; ++pass)
            {
                let u = osc * 0.8f - k * y4;
                y1 += g * (tanh (u) - tanh (y1));
                y2 += g * (tanh (y1) - tanh (y2));
                y3 += g * (tanh (y2) - tanh (y3));
                y4 += g * (tanh (y3) - tanh (y4));
            }

            let filtered = y4 * (1.0f + k * 0.45f);

            // lopsided overdrive (the bias adds the dirty even harmonics), then a wavefold
            let bias = 0.35f * drive;
            let driven = tanh (filtered * (1.0f + drive * 18.0f) + bias) - tanh (bias);
            let folded = sin (driven * (1.5f + grit * 7.0f));
            let shaped = driven + (folded - driven) * grit;

            // the bias leaves a DC offset behind, so take it out
            dcOut = shaped - dcIn + 0.997f * dcOut;
            dcIn = shaped;

            out <- dcOut * amp * (0.75f + 0.35f * accent * accentSweep);
            advance();
        }
    }
}

//==============================================================================
// A dotted-eighth ping-pong echo with a darkened, saturated feedback path.
processor Echo
{
    input stream float in;
    input value float bpm;
    input value float mix;
    input value float volume;
    output stream float<2> out;

    let bufferSize = 192000;   // two seconds at 96kHz

    float[bufferSize] left, right;
    wrap<bufferSize> writePos;
    float delaySamples = 1000.0f;
    float lowL, lowR, bassL, bassR, gain;

    void main()
    {
        loop
        {
            let target = clamp (60.0f / max (bpm, 20.0f) * 0.75f * float (processor.frequency), 1.0f, float (bufferSize - 2));
            delaySamples += (target - delaySamples) * 0.0004f;

            var readPosition = float (writePos) - delaySamples;

            if (readPosition < 0.0f)
                readPosition += float (bufferSize);

            // linear interpolation between the two samples either side of the read position
            let index = int (floor (readPosition));
            let fraction = readPosition - float (index);
            let echoL = left.at (index) + (left.at (index + 1) - left.at (index)) * fraction;
            let echoR = right.at (index) + (right.at (index + 1) - right.at (index)) * fraction;

            // darken, remove low end, and saturate what goes back round
            let lowCoeff = 1.0f - exp (-float (twoPi) * 2500.0f * float (processor.period));
            let bassCoeff = 1.0f - exp (-float (twoPi) * 200.0f * float (processor.period));
            lowL += (echoL - lowL) * lowCoeff;
            lowR += (echoR - lowR) * lowCoeff;
            bassL += (lowL - bassL) * bassCoeff;
            bassR += (lowR - bassR) * bassCoeff;

            // ping-pong: the input goes into the left line, and each side feeds the other
            left[writePos]  = in + tanh (0.7f * (lowR - bassR));
            right[writePos] = tanh (0.7f * (lowL - bassL));
            ++writePos;

            gain += (pow (10.0f, volume / 20.0f) - gain) * 0.001f;
            let wet = float<2> (echoL, echoR) * mix;
            let mixed = (float<2> (in, in) + wet) * gain;
            out <- float<2> (tanh (mixed[0]), tanh (mixed[1]));

            advance();
        }
    }
}

/**
    Smear - a multiband spectral effect for drums, rumbles and anything else.

    The input is cut into overlapping frames, turned into a spectrum, reshaped, and turned
    back into sound. Each bin's true frequency is measured from how far its phase moved
    since the last frame (a phase vocoder), which is what lets the spectrum be shifted in
    pitch and frozen into a steady drone without going rough.

    The spectrum is split into three bands (low, mid and high) by two crossovers with soft
    edges, and each band is reshaped on its own: Freeze holds it and keeps playing it, Smear
    blurs every bin's level over time, Shift moves it up or down, Peaks throws away all but
    its loudest bins, Scatter randomises its phases so it turns breathy and diffuse, and
    Level sets how loud it comes back. Scale switches Pull on or off and defaults to Off.
    Pull Strength sets how strongly each note moves towards the chosen key and scale.
    Its pitch centre moves, so vibrato and drift come through as they
    were, its overtones move with it, and noise is left where it was. Tilt then leans the
    whole balance towards the lows or highs without changing the loudness.

    An LFO and an envelope follower move Smear, Shift and Scatter around their knob settings
    in all three bands. Depth sets the LFO's movement. Shape blends between sine, triangle,
    ramp down and square, with Snap choosing one shape at a time.
    Randomize mixes in repeatable random movement, and Spread carries it from band to band.
    Sync follows the host's tempo and playing position, or Rate sets the speed in Hz.
    The envelope follows the louder input channel, with Attack and Release setting how
    quickly it rises and falls. Sensitivity adjusts the level that drives it, from no
    movement at -48 dB to full movement at 0 dB. Its three amounts set how far each target
    moves, equally in all bands, with no separate depth control.
    Envelope switches its movement on or off with a short fade, while the follower keeps
    tracking. With zero LFO Depth, the knobs are fully manual when Envelope is off or its
    amounts are zero. Switching off finishes the fade before returning to manual control.

    Both engines use 2048-sample frames at the full sample rate, with a split at 1kHz.
    The low engine analyses the sound, and the upper engine follows its moves.
    At 48kHz, each bin spans about 23Hz, compared with about 6Hz at the previous quarter rate.
    Close bass harmonics and chord notes are less well separated, in exchange for less delay.

    Alongside them runs a short 256-sample FFT that picks out onsets as they arrive.
    Transients sets how much of them goes around the long frames and is added back untouched,
    so hits stay sharp however smeared or frozen the rest is. Phase on Minimum makes any
    ringing from the reshaping come after a hit instead of before it.

    With neutral settings, the sound passes through with a 2304-sample delay (48ms at 48kHz).
    This includes the 2048-sample frames and the 256-sample transient splitter.
    The dry signal has the same delay, so Mix does not cause comb filtering.

    Pull Mode picks between this way of working (Precise) and the one Smear had before it
    (Classic, in SmearClassic.cmajor), which pulls every partial on its own on 2048-sample
    frames, for a grainier, more obviously tuned sound. Both run as nodes of the graph below
    and are added together; whichever isn't chosen does nothing, and changing the mode warms
    the new one up unheard for 0.4 seconds and then crossfades.
*/

graph Smear  [[ main ]]
{
    input stream float<2> in;
    output stream float<2> out;
    output event smear::Spectrum spectrumOut;   // the output's spectrum, about 45 times a second, for the GUI
    output event SmearModulation::ModulationDisplay modulationOut;   // modulation and input peaks, delayed to match the audio, about 60 times a second

    input value float lowCross     [[ name: "Low Crossover",  min: 40,  max: 1000,  init: 200,  unit: "Hz" ]];
    input value float highCross    [[ name: "High Crossover", min: 500, max: 10000, init: 2500, unit: "Hz" ]];

    input value int   lowFreeze    [[ name: "Low Freeze",     min: 0,   max: 1,     init: 0,    text: "Off|On" ]];
    input value float lowSmear     [[ name: "Low Smear",      min: 0,   max: 1,     init: 0.3 ]];
    input value float lowShift     [[ name: "Low Shift",      min: -24, max: 24,    init: 0,    unit: "st" ]];
    input value float lowPeaks     [[ name: "Low Peaks",      min: 0,   max: 1,     init: 0 ]];
    input value float lowScatter   [[ name: "Low Scatter",    min: 0,   max: 1,     init: 0 ]];
    input value float lowLevel     [[ name: "Low Level",      min: -36, max: 12,    init: 0,    unit: "dB" ]];

    input value int   midFreeze    [[ name: "Mid Freeze",     min: 0,   max: 1,     init: 0,    text: "Off|On" ]];
    input value float midSmear     [[ name: "Mid Smear",      min: 0,   max: 1,     init: 0.3 ]];
    input value float midShift     [[ name: "Mid Shift",      min: -24, max: 24,    init: 0,    unit: "st" ]];
    input value float midPeaks     [[ name: "Mid Peaks",      min: 0,   max: 1,     init: 0 ]];
    input value float midScatter   [[ name: "Mid Scatter",    min: 0,   max: 1,     init: 0 ]];
    input value float midLevel     [[ name: "Mid Level",      min: -36, max: 12,    init: 0,    unit: "dB" ]];

    input value int   highFreeze   [[ name: "High Freeze",    min: 0,   max: 1,     init: 0,    text: "Off|On" ]];
    input value float highSmear    [[ name: "High Smear",     min: 0,   max: 1,     init: 0.3 ]];
    input value float highShift    [[ name: "High Shift",     min: -24, max: 24,    init: 0,    unit: "st" ]];
    input value float highPeaks    [[ name: "High Peaks",     min: 0,   max: 1,     init: 0 ]];
    input value float highScatter  [[ name: "High Scatter",   min: 0,   max: 1,     init: 0 ]];
    input value float highLevel    [[ name: "High Level",     min: -36, max: 12,    init: 0,    unit: "dB" ]];

    input value float magnet       [[ name: "Pull Strength",  min: 0,   max: 1,     init: 0 ]];
    input value int   key          [[ name: "Key",            min: 0,   max: 11,    init: 0,    text: "C|C#|D|D#|E|F|F#|G|G#|A|A#|B" ]];
    input value int   scale        [[ name: "Scale",          min: 0,   max: 11,    init: 1,    text: "Major|Minor|Dorian|Phrygian|Lydian|Mixolydian|Harm Minor|Pent Major|Pent Minor|Whole Tone|Fifths|Octaves" ]];
    input value int   scaleEnabled [[ name: "Scale",          min: 0,   max: 1,     init: 0,    text: "Off|On" ]];

    input value float transients   [[ name: "Transients",     min: 0,   max: 1,     init: 0.5 ]];
    input value int   phaseMode    [[ name: "Phase",          min: 0,   max: 1,     init: 1,    text: "Original|Minimum" ]];
    input value float tilt         [[ name: "Tilt",           min: -12, max: 12,    init: 0,    unit: "dB/oct" ]];
    input value float mix          [[ name: "Mix",            min: 0,   max: 1,     init: 1 ]];
    input value float volume       [[ name: "Output",         min: -24, max: 12,    init: 0,    unit: "dB" ]];
    input value int   pullMode     [[ name: "Pull Mode",      min: 0,   max: 1,     init: 0,    text: "Precise|Classic" ]];

    input value float lfoDepth     [[ name: "LFO Depth",      min: 0,    max: 1,   init: 0 ]];
    input value float lfoRate      [[ name: "LFO Rate",       min: 0.02, max: 20,  init: 0.5, unit: "Hz" ]];
    input value int   lfoSync      [[ name: "LFO Sync",       min: 0,    max: 1,   init: 0,   text: "Off|On" ]];
    input value int   lfoDivision  [[ name: "LFO Sync Rate",  min: 0,    max: 13,  init: 3,   text: "8 Bars|4 Bars|2 Bars|1 Bar|1/2|1/4|1/8|1/16|1/2T|1/4T|1/8T|1/16T|1/4D|1/8D" ]];
    input value float lfoShape     [[ name: "LFO Shape",      min: 0,    max: 3,   init: 0 ]];
    input value int   lfoSnap      [[ name: "Shape Snap",     min: 0,    max: 1,   init: 0,   text: "Off|On" ]];
    input value float lfoRandom    [[ name: "LFO Randomize",  min: 0,    max: 1,   init: 0 ]];
    input value float lfoSpread    [[ name: "Band Spread",    min: -180, max: 180, init: 0,   unit: "deg" ]];
    input value float lfoToSmear   [[ name: "LFO > Smear",    min: -1,   max: 1,   init: 0.5 ]];
    input value float lfoToShift   [[ name: "LFO > Shift",    min: -24,  max: 24,  init: 0,   unit: "st" ]];
    input value float lfoToScatter [[ name: "LFO > Scatter",  min: -1,   max: 1,   init: 0 ]];

    input value int   envEnabled     [[ name: "Envelope",        min: 0,   max: 1,    init: 0,   text: "Off|On" ]];
    input value float envAttack      [[ name: "Env Attack",      min: 0.1, max: 200,  init: 5,   unit: "ms" ]];
    input value float envRelease     [[ name: "Env Release",     min: 5,   max: 2000, init: 150, unit: "ms" ]];
    input value float envSensitivity [[ name: "Env Sensitivity", min: -24, max: 24,   init: 0,   unit: "dB" ]];
    input value float envToSmear     [[ name: "Env > Smear",      min: -1,  max: 1,    init: 0 ]];
    input value float envToShift     [[ name: "Env > Shift",      min: -24, max: 24,   init: 0,   unit: "st" ]];
    input value float envToScatter   [[ name: "Env > Scatter",    min: -1,  max: 1,    init: 0 ]];

    input event std::timeline::Tempo tempoIn;
    input event std::timeline::TransportState transportIn;
    input event std::timeline::Position positionIn;

    node modulation = SmearModulation;
    node precise = SmearPrecise;
    node classic = SmearClassic;

    connection
    {
        in -> precise.in, classic.in, modulation.in;
        precise.out, classic.out -> out;
        precise.spectrumOut, classic.spectrumOut -> spectrumOut;
        modulation.modulationOut -> modulationOut;

        lowCross -> precise.lowCross, classic.lowCross;
        highCross -> precise.highCross, classic.highCross;
        lowFreeze -> precise.lowFreeze, classic.lowFreeze;
        lowSmear -> modulation.lowSmear;
        modulation.lowSmearOut -> precise.lowSmear, classic.lowSmear;
        lowShift -> modulation.lowShift;
        modulation.lowShiftOut -> precise.lowShift, classic.lowShift;
        lowPeaks -> precise.lowPeaks, classic.lowPeaks;
        lowScatter -> modulation.lowScatter;
        modulation.lowScatterOut -> precise.lowScatter, classic.lowScatter;
        lowLevel -> precise.lowLevel, classic.lowLevel;
        midFreeze -> precise.midFreeze, classic.midFreeze;
        midSmear -> modulation.midSmear;
        modulation.midSmearOut -> precise.midSmear, classic.midSmear;
        midShift -> modulation.midShift;
        modulation.midShiftOut -> precise.midShift, classic.midShift;
        midPeaks -> precise.midPeaks, classic.midPeaks;
        midScatter -> modulation.midScatter;
        modulation.midScatterOut -> precise.midScatter, classic.midScatter;
        midLevel -> precise.midLevel, classic.midLevel;
        highFreeze -> precise.highFreeze, classic.highFreeze;
        highSmear -> modulation.highSmear;
        modulation.highSmearOut -> precise.highSmear, classic.highSmear;
        highShift -> modulation.highShift;
        modulation.highShiftOut -> precise.highShift, classic.highShift;
        highPeaks -> precise.highPeaks, classic.highPeaks;
        highScatter -> modulation.highScatter;
        modulation.highScatterOut -> precise.highScatter, classic.highScatter;
        highLevel -> precise.highLevel, classic.highLevel;
        magnet -> modulation.magnet;
        scaleEnabled -> modulation.scaleEnabled;
        modulation.magnetOut -> precise.magnet, classic.magnet;
        key -> precise.key, classic.key;
        scale -> precise.scale, classic.scale;
        transients -> precise.transients, classic.transients;
        phaseMode -> precise.phaseMode, classic.phaseMode;
        tilt -> precise.tilt, classic.tilt;
        mix -> precise.mix, classic.mix;
        volume -> precise.volume, classic.volume;
        pullMode -> precise.pullMode, classic.pullMode;

        lfoDepth -> modulation.lfoDepth;
        lfoRate -> modulation.lfoRate;
        lfoSync -> modulation.lfoSync;
        lfoDivision -> modulation.lfoDivision;
        lfoShape -> modulation.lfoShape;
        lfoSnap -> modulation.lfoSnap;
        lfoRandom -> modulation.lfoRandom;
        lfoSpread -> modulation.lfoSpread;
        lfoToSmear -> modulation.lfoToSmear;
        lfoToShift -> modulation.lfoToShift;
        lfoToScatter -> modulation.lfoToScatter;
        envEnabled -> modulation.envEnabled;
        envAttack -> modulation.envAttack;
        envRelease -> modulation.envRelease;
        envSensitivity -> modulation.envSensitivity;
        envToSmear -> modulation.envToSmear;
        envToShift -> modulation.envToShift;
        envToScatter -> modulation.envToScatter;
        tempoIn -> modulation.tempoIn;
        transportIn -> modulation.transportIn;
        positionIn -> modulation.positionIn;
    }
}

//==============================================================================
processor SmearPrecise
{
    input stream float<2> in;
    output stream float<2> out;
    output event smear::Spectrum spectrumOut;

    input value float lowCross;
    input value float highCross;

    input value int   lowFreeze;
    input value float lowSmear;
    input value float lowShift;
    input value float lowPeaks;
    input value float lowScatter;
    input value float lowLevel;

    input value int   midFreeze;
    input value float midSmear;
    input value float midShift;
    input value float midPeaks;
    input value float midScatter;
    input value float midLevel;

    input value int   highFreeze;
    input value float highSmear;
    input value float highShift;
    input value float highPeaks;
    input value float highScatter;
    input value float highLevel;

    input value float magnet;
    input value int   key;
    input value int   scale;

    input value float transients;
    input value int   phaseMode;
    input value float tilt;
    input value float mix;
    input value float volume;
    input value int   pullMode;

    processor.latency = smear::lowLatency + smear::shortSize;

    let algorithm = 0;   // which Pull Mode this is
    smear::Switcher switcher;

    //==============================================================================
    namespace frames = smear::stft (smear::fftSize);

    frames::Engine lowEngine;     // below smear::engineSplit, at sample rate / decimation
    frames::Engine upperEngine;   // everything above it
    smear::Controls controls;

    // Resample only when decimation > 1. The same lowpass filter removes aliases and images.
    // Interpolation uses one filter phase per output sample.
    let decimation = smear::decimation;
    let filterLength = smear::filterLength;
    let interpolatorLength = (filterLength + decimation - 1) / decimation;
    float[filterLength] resamplingFilter;
    float<2>[filterLength] decimatorHistory;
    float<2>[interpolatorLength] interpolatorHistory;
    wrap<filterLength> decimatorPosition;
    wrap<interpolatorLength> interpolatorPosition;
    int samplesSinceDecimation;

    // The upper engine's input is held back so that what comes out of it lines up with the
    // low engine's output, and so that its frames are never ahead of the low engine's, whose
    // moves it follows
    let upperDelay = smear::lowLatency - smear::fftSize;
    smear::Delayed[max (1, upperDelay)] upperDelayLine;
    wrap<max (1, upperDelay)> upperDelayPosition;

    // The sample each of the low engine's last three frames was made on (the upper engine
    // keeps their moves), so the upper engine can blend between the two either side of its
    // own frame. The middle of the upper engine's frame is this much further back in the
    // input than the middle of a low frame made on the same sample (both frames' middles
    // are half their length, less a sample, behind their newest sample).
    let lowMovesLag = (upperDelay + smear::fftSize / 2 - 1) - (smear::resamplingDelay / 2 + decimation * (smear::fftSize / 2 - 1));
    int64[3] lowMovesMadeAt;
    wrap<3> newestLowMoves;
    int64 sampleCount;

    // The transient splitter: a short FFT that picks out onsets as they arrive, so they can
    // go around the long frames (which would smear them backwards in time) and be added
    // back untouched
    let shortSize = smear::shortSize;
    let shortHop = shortSize / 4;
    let shortBins = shortSize / 2 + 1;
    let colaGain = 2.0f / 3.0f;   // Hann in and out at 75% overlap sums to 1.5
    smear::ShortChannel leftShort, rightShort;
    float[shortSize] shortWindow;
    float[shortBins] onsetFast, onsetSlow, onsetPeak, onsetMask, fastCoefficient, slowCoefficient, peakDecay, maskDecay;
    bool[shortBins] isRising;
    wrap<shortSize> shortPosition;
    int shortCountdown = shortHop;
    float keepAmount;

    int framesUntilSpectrum;
    float gain = 1.0f;

    // Level matching: smearing, scattering and thinning all lose level (frames whose phases
    // don't line up partly cancel as they overlap), so the wet signal is slowly brought back
    // to the dry signal's level, times whatever the band levels ask for. While every band is
    // frozen it holds, so the drone doesn't swell up when the input stops.
    float dryPower, wetPower, levelMatch = 1.0f, wetLimit = 1.0f;

    //==============================================================================
    void main()
    {
        frames::initialise (lowEngine, true, 777L, float (processor.frequency) / float (decimation));
        frames::initialise (upperEngine, false, 778L, float (processor.frequency));

        // At full rate, render the low frame first and use its moves for the same upper frame.
        // At reduced rates, keep the previous offset between frame calculations.
        if const (decimation > 1)
            lowEngine.hopCountdown = frames::hopSize / (2 * decimation);

        if const (decimation > 1)
            designResamplingFilter();

        for (wrap<shortSize> i)
            shortWindow[i] = 0.5f - 0.5f * cos (float (twoPi) * float (i) / float (shortSize));

        smear::startSwitcher (switcher, pullMode == algorithm);

        setUpOnsetDetector();

        let powerCoefficient = 1.0f - exp (-1.0f / (0.4f * float (processor.frequency)));
        let warmingPowerCoefficient = 1.0f - exp (-1.0f / (0.1f * float (processor.frequency)));
        let limitRelease = 1.0f - exp (-1.0f / (0.1f * float (processor.frequency)));

        loop
        {
            // while it's neither chosen nor heard, it does nothing
            while (! smear::updateSwitcher (switcher, pullMode == algorithm, processor.frequency))
                advance();

            // The splitter: what went in shortSize samples ago, and the onsets picked out of it
            let delayedIn = float<2> (leftShort.incoming[shortPosition], rightShort.incoming[shortPosition]);
            let onset = float<2> (leftShort.outgoing[shortPosition], rightShort.outgoing[shortPosition]);

            leftShort.incoming[shortPosition] = in[0];
            rightShort.incoming[shortPosition] = in[1];
            leftShort.outgoing[shortPosition] = 0.0f;
            rightShort.outgoing[shortPosition] = 0.0f;

            // the kept onsets go around the long frames, and the rest goes through them
            keepAmount += (transients - keepAmount) * 0.001f;
            let kept = onset * keepAmount;
            let steady = delayedIn - kept;

            // The upper engine works on the input held back by upperDelay, and gives back the
            // dry signal too (what went into it fftSize samples ago), so both line up with the
            // low engine's output
            smear::Delayed held;
            held.steady = steady;
            held.kept = kept;

            if const (upperDelay > 0)
            {
                held = upperDelayLine[upperDelayPosition];
                upperDelayLine[upperDelayPosition].steady = steady;
                upperDelayLine[upperDelayPosition].kept = kept;
                ++upperDelayPosition;
            }

            let steadyDry = frames::getDueInput (upperEngine);
            let keptDry = frames::getDueKept (upperEngine);
            let dry = steadyDry + keptDry;
            let wet = runLowEngine (steady) + frames::exchange (upperEngine, held.steady, held.kept);

            // while its frames fill after a warm-up began, what it measured before is forgotten
            if (smear::isFilling (switcher))
            {
                dryPower = 0.0f;
                wetPower = 0.0f;
            }
            else if (lowFreeze == 0 || midFreeze == 0 || highFreeze == 0)
            {
                // and while it warms up unheard it measures over a shorter time and catches up
                // both ways quickly, so it comes in at the right level
                let isWarming = smear::isWarming (switcher);
                let coefficient = isWarming ? warmingPowerCoefficient : powerCoefficient;

                dryPower += (steadyDry[0] * steadyDry[0] + steadyDry[1] * steadyDry[1] - dryPower) * coefficient;
                wetPower += (wet[0] * wet[0] + wet[1] * wet[1] - wetPower) * coefficient;

                // the level matcher aims for the dry level times what the band levels ask for
                let unlevelled = lowEngine.unlevelled + upperEngine.unlevelled;
                let intendedPower = unlevelled > 1.0e-20f ? (lowEngine.levelled + upperEngine.levelled) / unlevelled : 1.0f;

                // only while there's something to match, never boosting by more than 6dB, and
                // rising slowly so a sound that's still fading in doesn't get pushed too far
                if (dryPower > 1.0e-8f && wetPower > 1.0e-10f)
                {
                    let target = clamp (sqrt (dryPower * intendedPower / wetPower), 0.25f, 2.0f);
                    levelMatch += (target - levelMatch) * (target > levelMatch && ! isWarming ? 0.00005f : 0.001f);
                }
            }

            // smeared and scattered sound peaks higher for the same level, so the wet signal
            // has a limiter: instant when it would go over, letting go over about 100ms
            let matchedWet = wet * levelMatch;
            let wetPeak = max (abs (matchedWet[0]), abs (matchedWet[1]));
            wetLimit = wetPeak * wetLimit > 1.0f ? 1.0f / wetPeak : wetLimit + (1.0f - wetLimit) * limitRelease;

            gain += (pow (10.0f, volume / 20.0f) - gain) * 0.001f;
            out <- (dry * (1.0f - mix) + (matchedWet * wetLimit + keptDry) * mix) * gain * switcher.gain;

            ++shortPosition;

            if (--shortCountdown <= 0)
            {
                shortCountdown = shortHop;
                splitOnsets();
            }

            if (frames::isFrameDue (upperEngine))
            {
                gatherControls();
                chooseLowMoves();
                frames::renderFrame (upperEngine, controls);

                if (--framesUntilSpectrum <= 0)
                {
                    framesUntilSpectrum = 2;
                    if (smear::isHeard (switcher))
                        sendSpectrum();
                }
            }

            ++sampleCount;
            advance();
        }
    }

    // Picks the two low frames centred either side of the upper engine's frame, and how far
    // between them it is
    void chooseLowMoves()
    {
        if const (decimation == 1)
        {
            // Both frames have the same centre. No interpolation or phase advance is needed.
            controls.earlierLowMoves = newestLowMoves;
            controls.laterLowMoves = newestLowMoves;
            controls.lowMovesBlend = 1.0f;
            controls.secondsAfterEarlier = 0.0f;
            controls.secondsBeforeLater = 0.0f;
            return;
        }

        let wanted = sampleCount - int64 (lowMovesLag);
        wrap<3> previous = newestLowMoves;
        --previous;

        wrap<3> later = lowMovesMadeAt[previous] > wanted ? previous : newestLowMoves;
        wrap<3> earlier = later;
        --earlier;

        let spacing = float (lowMovesMadeAt[later] - lowMovesMadeAt[earlier]);
        controls.earlierLowMoves = earlier;
        controls.laterLowMoves = later;
        controls.lowMovesBlend = spacing > 0.0f ? clamp (float (wanted - lowMovesMadeAt[earlier]) / spacing, 0.0f, 1.0f) : 1.0f;
        controls.secondsAfterEarlier = float (wanted - lowMovesMadeAt[earlier]) / float (processor.frequency);
        controls.secondsBeforeLater = float (lowMovesMadeAt[later] - wanted) / float (processor.frequency);
    }

    //==============================================================================
    // Full-rate samples go directly through the low engine.
    // At reduced rates, the two filters add filterLength - 1 samples of delay.
    float<2> runLowEngine (float<2> steady)
    {
        if const (decimation == 1)
            return exchangeLowSample (steady);

        decimatorHistory[decimatorPosition] = steady;

        if (samplesSinceDecimation == 0)
        {
            float<2> down;
            wrap<filterLength> source = decimatorPosition;

            for (wrap<filterLength> i)
            {
                down += resamplingFilter[i] * decimatorHistory[source];
                --source;
            }

            ++interpolatorPosition;
            interpolatorHistory[interpolatorPosition] = exchangeLowSample (down);
        }

        float<2> up;
        wrap<interpolatorLength> source = interpolatorPosition;

        for (int i = 0; i < interpolatorLength; ++i)
        {
            let tap = samplesSinceDecimation + decimation * i;

            if (tap < filterLength)
                up += resamplingFilter.at (tap) * interpolatorHistory[source];

            --source;
        }

        ++decimatorPosition;
        samplesSinceDecimation = (samplesSinceDecimation + 1) % decimation;

        return up * float (decimation);
    }

    float<2> exchangeLowSample (float<2> sample)
    {
        let wet = frames::exchange (lowEngine, sample, float<2>());

        if (frames::isFrameDue (lowEngine))
        {
            gatherControls();
            frames::renderFrame (lowEngine, controls);

            ++newestLowMoves;
            upperEngine.recentLowMoves[newestLowMoves] = lowEngine.moves;
            lowMovesMadeAt[newestLowMoves] = sampleCount;
        }

        return wet;
    }

    // A Kaiser-windowed lowpass at the reduced rate's Nyquist frequency, with unity gain at DC.
    // With 81 taps and decimation 4, it stays within 0.001dB through 9% of the input rate.
    // Attenuation reaches 80dB from 16% of that rate.
    void designResamplingFilter()
    {
        if const (decimation == 1 || filterLength == 1)
        {
            // A single tap needs no window. Full-rate processing bypasses this filter.
            resamplingFilter = 0.0f;
            resamplingFilter[0] = 1.0f;
        }
        else
        {
            let beta = 7.857f;
            let middle = float (filterLength - 1) / 2.0f;
            float sum;

            for (wrap<filterLength> i)
            {
                let t = float (int (i)) - middle;
                let x = float (pi) * t / float (decimation);
                let sinc = abs (t) < 0.5f ? 1.0f : sin (x) / x;
                let r = t / middle;

                resamplingFilter[i] = sinc * smear::besselI0 (beta * sqrt (max (0.0f, 1.0f - r * r))) / smear::besselI0 (beta);
                sum += resamplingFilter[i];
            }

            for (wrap<filterLength> i)
                resamplingFilter[i] /= sum;
        }
    }

    //==============================================================================
    void gatherControls()
    {
        // while its frames are filling after a warm-up began, it neither smears nor freezes
        let filling = smear::isFilling (switcher);

        controls.bands[0] = smear::makeSettings (filling ? 0 : lowFreeze, filling ? 0.0f : lowSmear, lowShift,  lowPeaks,  lowScatter,  lowLevel);
        controls.bands[1] = smear::makeSettings (filling ? 0 : midFreeze, filling ? 0.0f : midSmear, midShift,  midPeaks,  midScatter,  midLevel);
        controls.bands[2] = smear::makeSettings (filling ? 0 : highFreeze, filling ? 0.0f : highSmear, highShift, highPeaks, highScatter, highLevel);

        controls.lowCross = lowCross;
        controls.highCross = highCross;
        controls.tilt = tilt;
        controls.magnet = magnet;
        controls.key = key;
        controls.scaleMask = smear::scaleMask (scale);
        controls.useMinimumPhase = phaseMode != 0;
    }

    //==============================================================================
    // The detector is ResoChecker's onset recovery: each bin's energy (with its neighbours,
    // about 150Hz either side) is followed by a fast and a slow average, and when the fast
    // one jumps well above the slow one that bin is an onset. It only starts one when the
    // energy also goes well above the most it's been lately (which lets go over at least
    // 60ms), so a low note's own waveform, which comes round loud and quiet every cycle,
    // isn't taken for a string of onsets. The mask opens at once and closes over a little
    // under a cycle of the bin's frequency, never quicker than 8ms.
    void setUpOnsetDetector()
    {
        let binWidth = float (processor.frequency) / float (shortSize);
        let hopSeconds = float (shortHop) / float (processor.frequency);

        for (wrap<shortBins> k)
        {
            let frequency = max (40.0f, float (int (k)) * binWidth);
            fastCoefficient[k] = 1.0f - exp (-hopSeconds / max (0.25f / frequency, 0.001f));
            slowCoefficient[k] = 1.0f - exp (-hopSeconds / max (3.0f / frequency, 0.02f));
            peakDecay[k] = exp (-hopSeconds / max (3.0f / frequency, 0.06f));
            maskDecay[k] = exp (-hopSeconds / max (0.8f / frequency, 0.008f));
        }
    }

    void splitOnsets()
    {
        analyseShort (leftShort);
        analyseShort (rightShort);

        let shortNyquist = shortSize / 2;
        let radius = max (1, int (150.0f * float (shortSize) / float (processor.frequency) + 0.5f));
        let normalise = 4.0f / float (shortSize * shortSize);

        float[shortBins] energy;

        for (wrap<shortBins> k)
        {
            let bin = int (k);
            energy[k] = (smear::powerAt (leftShort.spectrum, bin, shortNyquist) + smear::powerAt (rightShort.spectrum, bin, shortNyquist)) * normalise;
        }

        for (wrap<shortBins> k)
        {
            let bin = int (k);
            let low = max (0, bin - radius);
            let high = min (shortNyquist, bin + radius);
            float sum;

            for (int i = low; i <= high; ++i)
                sum += energy.at (i);

            let level = sum / float (high - low + 1);
            onsetFast[k] += (level - onsetFast[k]) * fastCoefficient[k];

            // compared with the slow average from before this hop, or a coarse hop could
            // swallow the whole attack
            let ratio = sqrt (onsetFast[k] / max (onsetSlow[k], 1.0e-12f));
            let rise = clamp ((ratio - 1.4f) / 2.6f, 0.0f, 1.0f);

            if (onsetFast[k] > 1.96f * onsetPeak[k])
                isRising[k] = true;
            else if (rise <= 0.0f)
                isRising[k] = false;

            let target = isRising[k] && onsetFast[k] > 1.0e-8f ? rise * rise * (3.0f - 2.0f * rise) : 0.0f;

            onsetMask[k] = max (target, onsetMask[k] * maskDecay[k]);
            onsetSlow[k] += (level - onsetSlow[k]) * slowCoefficient[k];
            onsetPeak[k] = max (level, onsetPeak[k] * peakDecay[k]);
        }

        resynthesiseShort (leftShort);
        resynthesiseShort (rightShort);
    }

    void analyseShort (smear::ShortChannel& c)
    {
        wrap<shortSize> source = shortPosition;

        for (wrap<shortSize> i)
        {
            c.frame[i] = c.incoming[source] * shortWindow[i];
            ++source;
        }

        std::frequency::realOnlyForwardFFT (c.frame, c.spectrum);
    }

    // Keeps only the onsets (each bin times its mask) and adds them into the splitter's output
    void resynthesiseShort (smear::ShortChannel& c)
    {
        let shortNyquist = shortSize / 2;

        for (wrap<shortBins> k)
        {
            let bin = int (k);
            c.spectrum.at (bin) *= onsetMask[k];

            if (bin > 0 && bin < shortNyquist)
                c.spectrum.at (shortNyquist + bin) *= onsetMask[k];
        }

        std::frequency::realOnlyInverseFFT (c.spectrum, c.frame);

        wrap<shortSize> target = shortPosition;

        for (wrap<shortSize> i)
        {
            c.outgoing[target] += c.frame[i] * shortWindow[i] * colaGain;
            ++target;
        }
    }

    //==============================================================================
    // The output's spectrum in log-spaced bands from 30Hz to 16kHz, each 0 (-84dB or
    // quieter) to 1 (0dB), averaging the two channels and taking whichever engine is louder
    void sendSpectrum()
    {
        smear::Spectrum s;

        for (wrap<smear::numDisplayBands> band)
        {
            let low = 30.0f * pow (16000.0f / 30.0f, float (int (band)) / float (smear::numDisplayBands));
            let high = 30.0f * pow (16000.0f / 30.0f, float (int (band) + 1) / float (smear::numDisplayBands));
            let level = max (frames::getDisplayLevel (lowEngine, low, high),
                             frames::getDisplayLevel (upperEngine, low, high));

            let decibels = 20.0f * log10 (max (level, 1.0e-6f));
            s.bands[band] = clamp ((decibels + 84.0f) / 84.0f, 0.0f, 1.0f);
        }

        spectrumOut <- s;
    }
}

//==============================================================================
namespace smear
{
    let fftSize = 2048;           // both engines' frames
    let engineSplit = 1000.0f;    // the low engine renders everything below this many Hz, and the upper engine everything above
    let decimation = 1;           // set to 4 to restore the previous quarter-rate processing and delay
                                 // Keep the patch manifest's latencySamples equal to lowLatency + shortSize.
    let filterLength = 81;        // the taps in the low engine's resampling filter
    static_assert (decimation > 0 && filterLength > 0);
    let resamplingDelay = decimation == 1 ? 0 : filterLength - 1;
    let lowLatency = decimation * fftSize + resamplingDelay;
    let shortSize = 256;          // the transient splitter's frames
    let numBands = 3;
    let numDisplayBands = 64;

    /// Fades one of the two Pull Modes in or out when the choice changes. One coming in from
    /// silence first runs unheard for long enough to fill its frames and delay lines and
    /// settle its trackers, while the one going out holds on at full level; then the two
    /// crossfade. For the first half of that, while its frames are still filling with what's
    /// playing now, it neither smears, freezes nor matches levels, so it doesn't carry on
    /// from whatever it last heard; in the second half it builds them up again. One switched
    /// back before it's finished fading just turns round. One that's neither chosen nor
    /// heard does nothing at all.
    struct Switcher
    {
        bool isWanted;
        int countdown, fillCountdown;
        float gain;
    }

    let warmUpSeconds = 0.4f;
    let fadeSeconds = 0.05f;

    void startSwitcher (Switcher& s, bool isWanted)
    {
        s.isWanted = isWanted;
        s.gain = isWanted ? 1.0f : 0.0f;
    }

    /// Moves the switcher on a sample, and says whether there's anything to run
    bool updateSwitcher (Switcher& s, bool isWanted, float64 sampleRate)
    {
        if (isWanted != s.isWanted)
        {
            // coming in from silence it warms up, and going out from full it waits for that
            let waits = isWanted ? s.gain == 0.0f : s.gain == 1.0f;
            s.isWanted = isWanted;
            s.countdown = waits ? max (int (warmUpSeconds * float (sampleRate)), 2 * (lowLatency + shortSize)) : 0;
            s.fillCountdown = isWanted && waits ? s.countdown / 2 : 0;
        }

        if (s.fillCountdown > 0)
            --s.fillCountdown;

        if (s.countdown > 0)
        {
            --s.countdown;
        }
        else
        {
            let step = 1.0f / (fadeSeconds * float (sampleRate));
            s.gain = isWanted ? min (1.0f, s.gain + step) : max (0.0f, s.gain - step);
        }

        return isWanted || s.gain > 0.0f;
    }

    /// Whether it's warming up to come in, and not heard yet
    bool isWarming (const Switcher& s)
    {
        return s.isWanted && s.countdown > 0;
    }

    /// Whether its frames are still filling with what's playing now, after a warm-up began
    bool isFilling (const Switcher& s)
    {
        return s.fillCountdown > 0;
    }

    /// Whether this is the one being heard, which is the one that shows its spectrum
    bool isHeard (const Switcher& s)
    {
        return s.gain >= 0.5f;
    }

    /// One channel of the transient splitter's short frames
    struct ShortChannel
    {
        float[shortSize] incoming, outgoing, frame, spectrum;
    }

    /// The power of one bin of a spectrum laid out as realOnlyForwardFFT leaves it
    float powerAt (const float[shortSize]& spectrum, int bin, int nyquist)
    {
        let real = spectrum.at (bin);
        let imag = bin > 0 && bin < nyquist ? spectrum.at (nyquist + bin) : 0.0f;
        return real * real + imag * imag;
    }

    /// One sample of what goes to the upper engine, held back to line up with the low engine
    struct Delayed
    {
        float<2> steady, kept;
    }

    /// The zeroth-order modified Bessel function of the first kind, for the Kaiser window
    float besselI0 (float x)
    {
        float sum = 1.0f, term = 1.0f;

        for (int k = 1; k < 30; ++k)
        {
            let factor = x / (2.0f * float (k));
            term *= factor * factor;
            sum += term;
        }

        return sum;
    }

    /// One band's settings for a frame, worked out from its controls
    struct BandSettings
    {
        bool isFrozen;
        float smearSeconds, shiftRatio, peaks, scatter, gain;
    }

    BandSettings makeSettings (int freeze, float smear, float shift, float peaks, float scatter, float levelDecibels)
    {
        BandSettings s;
        s.isFrozen = freeze != 0;
        s.smearSeconds = 4.0f * smear * smear;   // up to 4 seconds, with finer control at the short end
        s.shiftRatio = pow (2.0f, shift / 12.0f);
        s.peaks = peaks;
        s.scatter = scatter;
        s.gain = levelDecibels <= -35.9f ? 0.0f : pow (10.0f, levelDecibels / 20.0f);
        return s;
    }

    /// The low engine's frequency shifts and phases for each band and bin.
    /// The upper engine follows these moves below highestFrequency.
    /// At full rate, both engines use the same frame centres and bin widths.
    struct LowMoves
    {
        float[numBands, fftSize / 2 + 1] shift, phase;   // how far each bin moved (in Hz), and how far its phases had been turned by the middle of the frame
        float binWidth, highestFrequency;
        bool isValid;
    }

    /// Everything the engines need to know about the controls for a frame
    struct Controls
    {
        BandSettings[numBands] bands;
        float lowCross, highCross, tilt, magnet;
        int key, scaleMask;
        bool useMinimumPhase;

        // which two of the low engine's last three frames are centred either side of the
        // upper engine's frame, how far between them it is, and how many seconds after the
        // first and before the second
        wrap<3> earlierLowMoves, laterLowMoves;
        float lowMovesBlend, secondsAfterEarlier, secondsBeforeLater;
    }

    /// Which of the 12 notes above the key are in each scale, one bit per semitone
    int scaleMask (int scale)
    {
        let masks = int[12] (0xab5,    // major
                             0x5ad,    // natural minor
                             0x6ad,    // dorian
                             0x5ab,    // phrygian
                             0xad5,    // lydian
                             0x6b5,    // mixolydian
                             0x9ad,    // harmonic minor
                             0x295,    // major pentatonic
                             0x4a9,    // minor pentatonic
                             0x555,    // whole tone
                             0x081,    // root and fifth
                             0x001);   // root only

        return masks.at (clamp (scale, 0, 11));
    }

    /// A frequency in semitones above the key's lowest note (MIDI numbering, less the key)
    float toSemitones (float frequency, int key)
    {
        return 12.0f * log (frequency / 440.0f) / log (2.0f) + 69.0f - float (key);
    }

    /// The nearest note of the scale to a pitch in semitones (as toSemitones gives it). If
    /// the note it was on last time is still in the scale and no more than 30 cents further
    /// away than the nearest, it stays on that, so a pitch sitting between two notes doesn't
    /// flip from one to the other.
    int nearestNote (float semitones, int mask, int heldNote)
    {
        let below = int (floor (semitones));
        var nearest = below;
        float distance = 100.0f;

        for (int note = below - 6; note <= below + 7; ++note)
        {
            if (((mask >> ((note % 12 + 12) % 12)) & 1) == 0)
                continue;

            let d = abs (float (note) - semitones);

            if (d < distance)
            {
                distance = d;
                nearest = note;
            }
        }

        let isHeldInScale = ((mask >> ((heldNote % 12 + 12) % 12)) & 1) != 0;

        if (isHeldInScale && abs (float (heldNote) - semitones) < distance + 0.3f)
            return heldNote;

        return nearest;
    }

    /// A smooth step from 0 (at -1 and below) to 1 (at 1 and above)
    float fade (float x)
    {
        let t = clamp (x * 0.5f + 0.5f, 0.0f, 1.0f);
        return t * t * (3.0f - 2.0f * t);
    }

    /// The output's spectrum, for the GUI
    struct Spectrum
    {
        float[numDisplayBands] bands;
    }

    /// Wraps a phase into -pi..pi
    float wrapPhase (float p)
    {
        return p - float (twoPi) * floor (p / float (twoPi) + 0.5f);
    }

    //==============================================================================
    /**
        One spectral engine: a stereo phase vocoder on frames of fftSize samples, overlapping
        by three quarters, which reshapes whichever of the three bands it's given.

        Shift and Pull move the spectrum by its peaks: each peak takes the bins around it
        down to the dips either side, and the whole region moves together, keeping its own
        levels and phases. The phases are turned just enough to make up the new frequency,
        so nothing is rebuilt; a peak that doesn't need to move comes out exactly as it went
        in, and noise between the peaks stays noise. (This is Laroche and Dolson's
        phase-locked peak shifting.) The peaks are found in both channels together and both
        move the same way, so the stereo image stays put.

        Pull only tunes what's clearly a steady tone, so noise, breath and room are left
        where they were rather than being gathered onto the notes of the scale (which is
        what makes it sound metallic). It tunes each note's pitch centre, smoothed over about
        150ms, rather than every moment of it, so vibrato and drift come through as they
        were, and a note that's already in tune isn't touched at all. A peak that's a
        harmonic of a lower one moves with it, so a note's overtones stay in tune with it
        rather than each going to its own nearest note.

        The low engine (the analyser) works all this out for every frequency it can hear, in
        all three bands; the upper engine follows its moves wherever they reach, since its
        own shorter frames can't tell a chord's partials apart.
    */
    namespace stft (int fftSize)
    {
        let numBins = fftSize / 2 + 1;
        let nyquist = fftSize / 2;
        let hopSize = fftSize / 4;
        let maxPeaks = numBins / 2;
        let colaGain = 2.0f / 3.0f;                                          // Hann in and out at 75% overlap sums to 1.5
        let phaseStep = float (twoPi) * float (hopSize) / float (fftSize);   // how far a bin-centred tone's phase moves per hop
        let youngFrames = fftSize / hopSize;                                  // how many frames a new note takes to fill one

        /// One band's running state for one channel
        struct BandState
        {
            float[numBins] level, binFrequency, phase;
        }

        /// One channel's buffers and running state
        struct Channel
        {
            float[fftSize] incoming, outgoing, kept, frame, spectrum;
            float[numBins] lastPhase, measuredLevel, measuredBin, displayLevel;
            BandState[numBands] bands;
        }

        /// How one band moves each bin this frame, and what it carries from frame to frame
        struct BandPlan
        {
            int[numBins] move;                          // the whole bins it moves
            float[numBins] delta, turnReal, turnImag;   // how far its frequency moves (in bins), and the turn its phases get
            float[numBins] rotation;                    // how far its peak's phase had turned by the last frame
            int[numBins] heldNote;                      // the note its peak was pulled to in the last frame
        }

        struct Engine
        {
            Channel left, right;
            float sampleRate;   // the rate this engine's samples come at
            float[fftSize] window;
            bool[numBands] isActive;   // whether any of the band falls in this engine's half
            bool isAnalyser;           // the low engine: works out its moves itself, rather than following the analyser's
            wrap<fftSize> position;
            int hopCountdown;

            // how much of each bin belongs to each band in this engine; they add up to 1 where
            // this engine has the spectrum to itself, and fade out across engineSplit
            float[numBands, numBins] bandWeights;
            float[numBins] tiltGains;
            float lastTilt, lastLowCross, lastHighCross;

            // this frame's peaks: each one's true frequency (in bins), how sure it is to be a
            // steady tone rather than noise (0 to 1), its pitch and the pitch it's been
            // centred on lately (in semitones), how many frames it's been going, and which
            // root (if any) it's a harmonic of; and which peak's region each bin is in
            int[maxPeaks] peakBin, peakRoot, peakNote, peakAge, roots;
            float[maxPeaks] seriesTop, seriesSpacing;   // per root: its highest tonal harmonic so far, and their spacing
            float[maxPeaks] peakFrequency, peakShaped, peakTonality, peakPitch, peakSmoothed, peakCentre, peakRatio, peakTurned;
            float<2>[maxPeaks] peakEarlierPitches;   // its pitch one and two frames ago
            int numPeaks;

            // how one band moves each peak's region, before it's handed out to the bins
            int[maxPeaks] peakMove;
            float[maxPeaks] peakDelta, peakTurnReal, peakTurnImag;
            int[numBins] binRegion;
            float[numBins] pickingLevel;
            float[numBins + 1] logLevelSum;   // the sum of the log levels of all the bins below each one
            BandPlan[numBands] plans;

            // per bin: what its peak was doing in the last frame, for whichever peak it's
            // nearest in the next one
            float[numBins] lastPitch, lastSmoothed, lastCentre, lastTonality;
            float<2>[numBins] earlierPitches;   // its pitch two and three frames ago
            int[numBins] lastAge;
            float centreCoefficient;

            // the analyser's moves for the upper engine to follow, as it works them out, and
            // the upper engine's copies of its last three frames of them
            LowMoves moves;
            LowMoves[3] recentLowMoves;

            // scratch for one channel's frame, as each band of it is moved, then as they're added up
            float[numBins] shiftedReal, shiftedImag, shiftedLevel, shiftedPeak, shiftedBin, shiftedPhase;
            float[numBins] movedLevel, combinedLevel, combinedPhase;

            // Minimum phase: whatever a frame's reshaping did to the levels is treated as a
            // filter, and that filter's minimum phase is added to the original phases, so the
            // ringing a sharp change makes comes after a hit instead of before it
            float[numBins] logGain, minimumPhase;
            bool[numBins] hasOriginalPhase;
            float[fftSize] cepstrum, cepstrumSpectrum;

            // the power going out with and without the band levels, per sample, for the level matcher
            float levelled, unlevelled;

            std::random::RNG rng;
        }

        void initialise (Engine& e, bool isAnalyser, int64 seed, float sampleRate)
        {
            e.sampleRate = sampleRate;

            for (wrap<fftSize> i)
                e.window[i] = 0.5f - 0.5f * cos (float (twoPi) * float (i) / float (fftSize));

            e.isAnalyser = isAnalyser;
            e.hopCountdown = hopSize;
            e.lastTilt = 1000.0f;
            e.lastLowCross = -1.0f;
            e.centreCoefficient = 1.0f - exp (-float (hopSize) / (0.1f * sampleRate));
            e.rng.seed (seed);

            // Full-rate analysis reaches Nyquist. The quarter-rate filter is flat through 36% of its output rate.
            e.moves.binWidth = sampleRate / float (fftSize);
            e.moves.highestFrequency = (decimation == 1 ? 0.5f : 0.36f) * sampleRate;
            e.moves.isValid = isAnalyser;
        }

        /// What went in fftSize samples ago, which is about to be overwritten
        float<2> getDueInput (const Engine& e)  { return float<2> (e.left.incoming[e.position], e.right.incoming[e.position]); }
        float<2> getDueKept (const Engine& e)   { return float<2> (e.left.kept[e.position], e.right.kept[e.position]); }

        /// Takes in one sample (and the onsets that went around it) and gives back the wet
        /// sample that's due, which lines up with what went in fftSize samples ago
        float<2> exchange (Engine& e, float<2> steady, float<2> kept)
        {
            let wet = float<2> (e.left.outgoing[e.position], e.right.outgoing[e.position]);

            e.left.incoming[e.position] = steady[0];
            e.right.incoming[e.position] = steady[1];
            e.left.kept[e.position] = kept[0];
            e.right.kept[e.position] = kept[1];
            e.left.outgoing[e.position] = 0.0f;
            e.right.outgoing[e.position] = 0.0f;
            ++e.position;

            return wet;
        }

        bool isFrameDue (Engine& e)
        {
            if (--e.hopCountdown > 0)
                return false;

            e.hopCountdown = hopSize;
            return true;
        }

        //==============================================================================
        void renderFrame (Engine& e, const Controls& c)
        {
            if (c.tilt != e.lastTilt)
                updateTiltGains (e, c);

            if (c.lowCross != e.lastLowCross || c.highCross != e.lastHighCross)
                updateBandWeights (e, c);

            analyse (e, e.left);
            analyse (e, e.right);
            findPeaks (e);

            if (e.isAnalyser)
                trackPeaks (e);

            groupHarmonics (e);

            for (wrap<numBands> b)
                if (e.isActive[b] || e.isAnalyser)
                    planShifts (e, b, c);

            processChannel (e, e.left, c);
            processChannel (e, e.right, c);
        }

        // Takes the newest frame's spectrum, and measures every bin's level and its true
        // frequency (in bins), from how far its phase moved since the last frame compared
        // with where a bin-centred tone would be
        void analyse (Engine& e, Channel& ch)
        {
            // the frame ends at the newest sample, which is just behind `position`
            wrap<fftSize> source = e.position;

            for (wrap<fftSize> i)
            {
                ch.frame[i] = ch.incoming[source] * e.window[i];
                ++source;
            }

            std::frequency::realOnlyForwardFFT (ch.frame, ch.spectrum);

            for (wrap<numBins> k)
            {
                let bin = int (k);
                let real = ch.spectrum.at (bin);
                let imag = bin > 0 && bin < nyquist ? ch.spectrum.at (nyquist + bin) : 0.0f;
                let phase = atan2 (imag, real);
                let deviation = wrapPhase (phase - ch.lastPhase[k] - phaseStep * float (bin));

                ch.lastPhase[k] = phase;
                ch.measuredLevel[k] = sqrt (real * real + imag * imag);
                ch.measuredBin[k] = float (bin) + deviation / phaseStep;
            }
        }

        // Finds the peaks of both channels together (any bin louder than the two either side
        // of it, and no more than 120dB down), measures each one, and gives each peak the
        // bins from the dip below it to the dip above it. Two peaks with less than a 3dB dip
        // between them are one partial (like the two ends of a vibrato's swing, which a long
        // frame catches both of), so only the louder is kept, and its bins take in both.
        void findPeaks (Engine& e)
        {
            float loudest;

            for (wrap<numBins> k)
            {
                e.pickingLevel[k] = e.left.measuredLevel[k] + e.right.measuredLevel[k];
                loudest = max (loudest, e.pickingLevel[k]);
            }

            e.logLevelSum[0] = 0.0f;

            for (int k = 0; k < numBins; ++k)
                e.logLevelSum.at (k + 1) = e.logLevelSum.at (k) + log (e.pickingLevel.at (k) + 1.0e-12f);

            let threshold = loudest * 1.0e-6f;
            e.numPeaks = 0;

            for (int k = 1; k < nyquist && e.numPeaks < maxPeaks; ++k)
            {
                let level = e.pickingLevel.at (k);

                if (level > threshold
                     && level > e.pickingLevel.at (k - 1) && level >= e.pickingLevel.at (k + 1)
                     && (k < 2 || level > e.pickingLevel.at (k - 2))
                     && (k + 2 > nyquist || level >= e.pickingLevel.at (k + 2)))
                {
                    if (e.numPeaks > 0)
                    {
                        let previous = e.peakBin.at (e.numPeaks - 1);
                        var valley = level;

                        for (int i = previous + 1; i < k; ++i)
                            valley = min (valley, e.pickingLevel.at (i));

                        if (valley > 0.7f * min (level, e.pickingLevel.at (previous)))
                        {
                            if (level > e.pickingLevel.at (previous))
                                e.peakBin.at (e.numPeaks - 1) = k;

                            continue;
                        }
                    }

                    e.peakBin.at (e.numPeaks) = k;
                    ++e.numPeaks;
                }
            }

            for (int p = 0; p < e.numPeaks; ++p)
            {
                let k = e.peakBin.at (p);

                if (e.left.measuredLevel.at (k) >= e.right.measuredLevel.at (k))
                    measurePeak (e, e.left, p, k);
                else
                    measurePeak (e, e.right, p, k);
            }

            int first = 0;

            for (int p = 0; p < e.numPeaks; ++p)
            {
                var last = nyquist;

                if (p + 1 < e.numPeaks)
                {
                    last = e.peakBin.at (p);

                    for (int k = e.peakBin.at (p) + 1; k < e.peakBin.at (p + 1); ++k)
                        if (e.pickingLevel.at (k) < e.pickingLevel.at (last))
                            last = k;
                }

                for (int k = first; k <= last; ++k)
                    e.binRegion.at (k) = p;

                first = last + 1;
            }
        }

        // A peak's true frequency, and how sure it is to be a steady tone (1) rather than
        // noise (0). A tone stands well clear of the bins around it, or every bin it spreads
        // into measures the same frequency; a noise peak seldom does either. The frequency
        // comes two ways: from the phase vocoder (the louder channel's), which is the most
        // precise from moment to moment, and from the shape of the peak (the ratio of its two
        // biggest bins, which a Hann window makes exact for a steady tone), which averages
        // over the whole frame, so it's what the pitch centre follows. Where the two disagree
        // (a tone sliding within the frame), the shape is the safer guess for both.
        void measurePeak (Engine& e, const Channel& ch, int p, int k)
        {
            let level = e.pickingLevel.at (k);
            let below = e.pickingLevel.at (k - 1);
            let above = e.pickingLevel.at (k + 1);
            let side = max (below, above) / max (level, 1.0e-20f);
            let offset = clamp ((2.0f * side - 1.0f) / (side + 1.0f), 0.0f, 0.5f);
            let shaped = float (k) + (above >= below ? offset : -offset);
            let measured = ch.measuredBin.at (k);

            e.peakShaped.at (p) = shaped;
            e.peakFrequency.at (p) = abs (measured - shaped) < 1.0f ? measured : shaped;

            let top = log (level + 1.0e-12f);

            // how far it stands above the bins around it, leaving out its own main lobe (by
            // their geometric mean, so a neighbouring peak doesn't count for much): noise
            // peaks seldom reach 2.5 times, and tones are usually well past 5
            let first = max (0, k - 12);
            let last = min (nyquist, k + 12);
            let lobeFirst = max (0, k - 2);
            let lobeLast = min (nyquist, k + 2);
            let count = (lobeFirst - first) + (last - lobeLast);
            let logAround = e.logLevelSum.at (lobeFirst) - e.logLevelSum.at (first)
                             + e.logLevelSum.at (last + 1) - e.logLevelSum.at (lobeLast + 1);
            let standing = count > 0 ? exp (top - logAround / float (count)) : 100.0f;

            // how closely the bins either side agree with it on the frequency (which must be
            // its own: a sidelobe of a tone further off agrees too, but on that tone's)
            let spread = max (abs (ch.measuredBin.at (k - 1) - measured), abs (ch.measuredBin.at (k + 1) - measured));
            let isOwnFrequency = abs (measured - float (k)) < 0.75f;

            let clearOfNoise = clamp (log (standing / 2.5f) / log (2.0f), 0.0f, 1.0f);
            let steady = standing > 1.8f && isOwnFrequency ? clamp ((0.15f - spread) / 0.1f, 0.0f, 1.0f) : 0.0f;
            e.peakTonality.at (p) = max (clearOfNoise, steady);
        }

        // The analyser follows each peak on from the last frame (through whichever peak's
        // region its bin was in), and works out the pitch it's centred on: its last four
        // frames' pitches averaged to reduce changes between frames, then
        // smoothed twice over about 100ms, which together let through hardly any vibrato but
        // follow a slow drift, and catch up quickly with a pitch that's clearly moved on. Its
        // tonality it takes up over a couple of frames but only lets go of over about 300ms:
        // a note with vibrato looks less like a tone at some points of its swing than at
        // others, and it mustn't be pulled harder or softer in time with it. A pitch that's
        // jumped by more than 60 cents since the last frame, and is more than 85 cents from
        // where it was centred, is a new note and starts afresh (vibrato does the first but
        // not both). Until a new note has filled the frame (youngFrames), its pitch is taken as
        // it comes, and its history starts from there rather than from its first frames; for
        // the next couple it's centred on the average of what it's had so far.
        void trackPeaks (Engine& e)
        {
            let binWidth = e.sampleRate / float (fftSize);

            for (int p = 0; p < e.numPeaks; ++p)
            {
                let bin = e.peakBin.at (p);
                let pitch = toSemitones (max (e.peakShaped.at (p), 0.5f) * binWidth, 0);
                let lastPitch = e.lastPitch.at (bin);
                let earlier = e.earlierPitches.at (bin);
                let isNew = abs (pitch - lastPitch) > 0.6f && abs (pitch - e.lastCentre.at (bin)) > 0.85f;
                let age = isNew ? 0 : min (e.lastAge.at (bin) + 1, 1000);

                e.peakPitch.at (p) = pitch;
                e.peakEarlierPitches.at (p) = float<2> (lastPitch, earlier[0]);
                e.peakAge.at (p) = age;

                if (age <= youngFrames)
                {
                    e.peakEarlierPitches.at (p) = float<2> (pitch);
                    e.peakSmoothed.at (p) = pitch;
                    e.peakCentre.at (p) = pitch;
                }
                else if (age < youngFrames + 3)
                {
                    // while it settles in, it's centred on the average of what it's had so far
                    let averaged = age == youngFrames + 1 ? 0.5f * (pitch + lastPitch)
                                                          : (pitch + lastPitch + earlier[0]) / 3.0f;
                    e.peakSmoothed.at (p) = averaged;
                    e.peakCentre.at (p) = averaged;
                }
                else
                {
                    let averaged = 0.25f * (pitch + lastPitch + earlier[0] + earlier[1]);
                    let smoothed = followPitch (e.lastSmoothed.at (bin), averaged, e.centreCoefficient);
                    e.peakSmoothed.at (p) = smoothed;
                    e.peakCentre.at (p) = followPitch (e.lastCentre.at (bin), smoothed, e.centreCoefficient);
                }

                if (age > youngFrames)
                {
                    let tonality = e.peakTonality.at (p);
                    let last = e.lastTonality.at (bin);
                    e.peakTonality.at (p) = last + (tonality - last) * (tonality > last ? 0.5f : 0.15f);
                }
            }

            for (wrap<numBins> k)
            {
                if (e.numPeaks > 0)
                {
                    let p = e.binRegion[k];
                    e.lastPitch[k] = e.peakPitch.at (p);
                    e.earlierPitches[k] = e.peakEarlierPitches.at (p);
                    e.lastSmoothed[k] = e.peakSmoothed.at (p);
                    e.lastCentre[k] = e.peakCentre.at (p);
                    e.lastTonality[k] = e.peakTonality.at (p);
                    e.lastAge[k] = e.peakAge.at (p);
                }
                else
                {
                    e.lastPitch[k] = -1000.0f;
                    e.lastCentre[k] = -1000.0f;
                }
            }
        }

        // One step of smoothing a pitch, going much faster once it's more than about half a
        // semitone away (a note sliding into the next rather than wavering about one)
        float followPitch (float from, float to, float coefficient)
        {
            let quickness = clamp ((abs (to - from) - 0.3f) / 0.3f, 0.0f, 1.0f);
            return from + (to - from) * (coefficient + (0.8f - coefficient) * quickness);
        }

        // Groups the peaks into notes. Going up from the lowest, a peak is a harmonic of a
        // lower root if it's within about 3% of a whole-number multiple of it (up to the
        // 16th, and above that a tonal peak within a tenth of a harmonic of one, up to the
        // 64th), or if it lands where the root's series of tonal harmonics is heading (within
        // a tenth of their spacing of the next one or the one after), so a series that's a
        // little stretched, like a piano's, is followed all the way up. Only the harmonics
        // that fit closely carry the series on, so a stray tone in between can't knock it off
        // course. Where several roots fit, the one it fits best has it, and a root that's
        // quieter than the peak has to fit it that much better. A peak that's nobody's
        // harmonic is a root of its own if it's tonal, and otherwise it's noise.
        void groupHarmonics (Engine& e)
        {
            int numRoots = 0;

            for (int j = 0; j < e.numPeaks; ++j)
            {
                let frequency = e.peakFrequency.at (j);
                let level = e.pickingLevel.at (e.peakBin.at (j));
                let isTonal = e.peakTonality.at (j) >= 0.5f;
                var best = -1;
                float bestMiss = 1.0f, bestFit = 1.0f;

                for (int r = 0; r < numRoots; ++r)
                {
                    let root = e.roots.at (r);

                    // a root that's quieter than the peak has to fit it all the better, so a
                    // faint tone can't take a loud note's harmonics from it; 30dB quieter, and
                    // it can't have it at all
                    let rootLevel = e.pickingLevel.at (e.peakBin.at (root));
                    let quieter = rootLevel < level ? 0.29f * log (level / max (rootLevel, 1.0e-20f)) : 0.0f;

                    if (quieter >= bestMiss)
                        continue;

                    var fit = 1.0f;
                    let ratio = frequency / e.peakFrequency.at (root);
                    let harmonic = floor (ratio + 0.5f);

                    if (ratio > 1.94f && harmonic <= 16.0f)
                        fit = abs (ratio / harmonic - 1.0f) / min (0.03f, 0.45f / harmonic);
                    else if (harmonic > 16.0f && harmonic <= 64.0f && isTonal)
                        fit = abs (ratio - harmonic) / 0.1f;

                    let spacing = e.seriesSpacing.at (r);
                    let steps = floor ((frequency - e.seriesTop.at (r)) / spacing + 0.5f);

                    if (steps >= 1.0f && steps <= 2.0f)
                        fit = min (fit, abs (frequency - e.seriesTop.at (r) - steps * spacing) / (0.1f * spacing));

                    if (fit + quieter < bestMiss)
                    {
                        best = r;
                        bestMiss = fit + quieter;
                        bestFit = fit;
                    }
                }

                if (best >= 0)
                {
                    e.peakRoot.at (j) = e.roots.at (best);

                    // a tonal harmonic that's close to where it should be carries its root's
                    // series on up
                    let top = e.seriesTop.at (best);
                    let steps = floor ((frequency - top) / e.seriesSpacing.at (best) + 0.5f);

                    if (steps >= 1.0f && isTonal && bestFit < 0.35f)
                    {
                        e.seriesSpacing.at (best) = 0.5f * (e.seriesSpacing.at (best) + (frequency - top) / steps);
                        e.seriesTop.at (best) = frequency;
                    }
                }
                else
                {
                    e.peakRoot.at (j) = j;

                    if (frequency > 0.5f && isTonal)
                    {
                        e.roots.at (numRoots) = j;
                        e.seriesTop.at (numRoots) = frequency;
                        e.seriesSpacing.at (numRoots) = frequency;
                        ++numRoots;
                    }
                }
            }
        }

        // Works out how far each bin moves for one band. In the analyser, a peak's whole
        // region moves together: a root by Shift, and then with Pull towards the note of the
        // scale nearest the pitch it's centred on (holding on to the note it went to last time
        // unless another is clearly nearer), all the way once it's clearly a tone and less
        // for one that's only just tonal; a harmonic
        // by the same ratio as its root, and noise only by Shift. A new note is left as it is
        // in its first frame (where its pitch can be misread by a semitone, most of all in a
        // chord), taken half way in its second and all the way from its third, so it lands
        // before the ear hears it glide; until it has filled the frame and settled, its note
        // is chosen afresh each time. A note
        // that hasn't been moved yet is left alone while it's within 2 cents of its note, but
        // once it's been moved it's taken all the way, so it never jumps back. Each region
        // moves by whole bins, and its phases are turned to make up the exact frequency: on
        // from how far they'd turned by the middle of the last frame to the middle of this one
        // (from nothing for a new note). Counting at the middle of the frame means a move that
        // changes from one frame to the next turns them smoothly, without a kick that would
        // overshoot. A region that isn't moving is left just as it was, rather than keeping
        // whatever turn an earlier peak there had. (The frames start at their first sample
        // rather than their middle, so moving by a whole bin also flips the sign of every
        // other one; the angle takes that back off.)
        //
        // Within the analyser's reach, the upper engine moves each bin the way the analyser
        // moved that frequency, blending between its frames either side, with the phases turned
        // as far as the analyser's had been by the middle of this frame, so a partial the two
        // engines share comes out of both in step. It goes bin by bin rather than by its own
        // peaks. At reduced rates, the analyser can separate closer harmonics than the upper engine.
        // Above the analyser's reach, its harmonics follow their roots again.
        void planShifts (Engine& e, wrap<numBands> b, const Controls& c)
        {
            let binWidth = e.sampleRate / float (fftSize);
            let shiftRatio = c.bands[b].shiftRatio;
            let shiftSemitones = 12.0f * log (shiftRatio) / log (2.0f);

            let earlier = c.earlierLowMoves;
            let later = c.laterLowMoves;
            let followsAnalyser = ! e.isAnalyser && e.recentLowMoves[earlier].isValid && e.recentLowMoves[later].isValid;
            let reachBin = followsAnalyser ? min (int (e.recentLowMoves[later].highestFrequency / binWidth), numBins) : 0;
            let lowBinWidth = e.recentLowMoves[later].binWidth;

            for (int k = 0; k < reachBin; ++k)
            {
                let lowBin = wrap<numBins> (clamp (int (float (k) * binWidth / lowBinWidth + 0.5f), 0, numBins - 1));
                let earlierShift = e.recentLowMoves[earlier].shift[b, lowBin];
                let laterShift = e.recentLowMoves[later].shift[b, lowBin];
                let fromEarlier = e.recentLowMoves[earlier].phase[b, lowBin] + float (twoPi) * earlierShift * c.secondsAfterEarlier;
                let fromLater = e.recentLowMoves[later].phase[b, lowBin] - float (twoPi) * laterShift * c.secondsBeforeLater;
                let middleTurn = fromEarlier + wrapPhase (fromLater - fromEarlier) * c.lowMovesBlend;
                let delta = (earlierShift + (laterShift - earlierShift) * c.lowMovesBlend) / binWidth;
                let move = int (floor (delta + 0.5f));
                let angle = middleTurn - float (pi) * float (move);

                e.plans[b].move.at (k) = move;
                e.plans[b].delta.at (k) = delta;
                e.plans[b].turnReal.at (k) = cos (angle);
                e.plans[b].turnImag.at (k) = sin (angle);
                e.plans[b].rotation.at (k) = wrapPhase (middleTurn - float (pi) * delta);
            }

            for (int p = 0; p < e.numPeaks; ++p)
            {
                let bin = e.peakBin.at (p);
                let root = e.peakRoot.at (p);
                let original = e.peakFrequency.at (p);
                let frequency = original * binWidth;
                let isFollowed = bin < reachBin;
                let isNew = e.isAnalyser && e.peakAge.at (p) == 0;
                var ratio = shiftRatio;
                var note = isNew ? -1000 : e.plans[b].heldNote.at (bin);

                if (isFollowed)
                {
                    ratio = original > 0.0f ? 1.0f + e.plans[b].delta.at (bin) / original : shiftRatio;
                }
                else if (root != p)
                {
                    ratio = e.peakRatio.at (root);
                    note = e.peakNote.at (root);
                }
                else if (e.isAnalyser && c.magnet > 0.0f && ! isNew
                          && e.peakTonality.at (p) > 0.5f && frequency * shiftRatio >= 20.0f)
                {
                    let isSettling = e.peakAge.at (p) < youngFrames + 3;
                    let centre = e.peakCentre.at (p) + shiftSemitones - float (c.key);
                    note = nearestNote (centre, c.scaleMask, isSettling ? -1000 : note);
                    let distance = float (note) - centre;
                    let sureness = min (1.0f, 4.0f * (e.peakTonality.at (p) - 0.5f));
                    let easeIn = min (1.0f, float (e.peakAge.at (p)) / 2.0f);

                    if (e.plans[b].rotation.at (bin) != 0.0f || abs (distance) >= 0.02f)
                        ratio *= pow (2.0f, distance * c.magnet * sureness * easeIn / 12.0f);
                }

                e.peakRatio.at (p) = ratio;

                // the analyser sizes each move by the pitch the peak is centred on rather than
                // where it happens to be in this frame, so a partial with vibrato, whose peak
                // jumps between the ends of its swing from one frame to the next, moves as a
                // whole and by the same amount every time
                let steadyFrequency = e.isAnalyser ? 440.0f * pow (2.0f, (e.peakCentre.at (p) - 69.0f) / 12.0f) / binWidth
                                                   : original;
                let delta = steadyFrequency * (ratio - 1.0f);
                let move = int (floor (delta + 0.5f));
                let lastMiddleTurn = e.plans[b].rotation.at (bin) + float (pi) * e.plans[b].delta.at (bin);
                let middleTurn = isFollowed ? lastMiddleTurn
                                            : delta == 0.0f ? 0.0f
                                                            : wrapPhase ((isNew ? 0.0f : lastMiddleTurn) + delta * phaseStep);
                let turned = wrapPhase (middleTurn - float (pi) * delta);
                let angle = middleTurn - float (pi) * float (move);

                e.peakMove.at (p) = move;
                e.peakDelta.at (p) = delta;
                e.peakTurnReal.at (p) = cos (angle);
                e.peakTurnImag.at (p) = sin (angle);
                e.peakTurned.at (p) = turned;
                e.peakNote.at (p) = note;
            }

            // hands each region's move out to its bins, keeping what its peak did for
            // whichever peak is nearest in the next frame; the analyser also writes down how
            // far it moved each bin (in Hz) and how far it had turned it by the middle of the
            // frame, for the upper engine
            for (int k = reachBin; k < numBins; ++k)
            {
                if (e.numPeaks > 0)
                {
                    let p = e.binRegion.at (k);
                    e.plans[b].move.at (k) = e.peakMove.at (p);
                    e.plans[b].delta.at (k) = e.peakDelta.at (p);
                    e.plans[b].turnReal.at (k) = e.peakTurnReal.at (p);
                    e.plans[b].turnImag.at (k) = e.peakTurnImag.at (p);
                    e.plans[b].rotation.at (k) = e.peakTurned.at (p);
                    e.plans[b].heldNote.at (k) = e.peakNote.at (p);
                }
                else
                {
                    e.plans[b].move.at (k) = 0;
                    e.plans[b].delta.at (k) = 0.0f;
                    e.plans[b].turnReal.at (k) = 1.0f;
                    e.plans[b].turnImag.at (k) = 0.0f;
                    e.plans[b].rotation.at (k) = 0.0f;
                }

                if (e.isAnalyser)
                {
                    let lowBin = wrap<numBins> (k);
                    e.moves.shift[b, lowBin] = e.plans[b].delta.at (k) * binWidth;
                    e.moves.phase[b, lowBin] = e.plans[b].rotation.at (k) + float (pi) * e.plans[b].delta.at (k);
                }
            }
        }

        void processChannel (Engine& e, Channel& ch, const Controls& c)
        {
            for (wrap<numBins> k)
                e.movedLevel[k] = 0.0f;

            for (wrap<numBands> b)
                if (e.isActive[b])
                    processBand (e, ch, b, c);

            resynthesise (e, ch, c);
        }

        // One band's share of the spectrum: moved, thinned, then smeared into (or held in)
        // its running levels, with its phases either kept or, while frozen, run on at their
        // frequencies
        void processBand (Engine& e, Channel& ch, wrap<numBands> b, const Controls& c)
        {
            let s = c.bands[b];
            let smearCoefficient = s.smearSeconds > 0.001f ? exp (-float (hopSize) / (s.smearSeconds * e.sampleRate)) : 0.0f;

            shiftBand (e, ch, b);
            keepPeaks (e, s.peaks);

            for (wrap<numBins> k)
            {
                if (! s.isFrozen)
                {
                    ch.bands[b].level[k] = e.shiftedLevel[k] + (ch.bands[b].level[k] - e.shiftedLevel[k]) * smearCoefficient;
                    ch.bands[b].binFrequency[k] = e.shiftedBin[k];
                }

                ch.bands[b].phase[k] = s.isFrozen ? wrapPhase (ch.bands[b].phase[k] + phaseStep * ch.bands[b].binFrequency[k])
                                                  : e.shiftedPhase[k];
            }
        }

        // Moves a band's share of each bin as planned, turning its phases. Where bins land in
        // the same place they add up, and the louder decides the frequency a frozen band
        // carries on at.
        void shiftBand (Engine& e, Channel& ch, wrap<numBands> b)
        {
            for (wrap<numBins> k)
            {
                e.shiftedReal[k] = 0.0f;
                e.shiftedImag[k] = 0.0f;
                e.shiftedPeak[k] = 0.0f;
                e.shiftedBin[k] = float (int (k));
            }

            for (wrap<numBins> k)
            {
                let weight = e.bandWeights[b, k];

                if (weight <= 0.0f)
                    continue;

                let bin = int (k);
                let target = bin + e.plans[b].move[k];

                if (target < 0 || target > nyquist)
                    continue;

                let real = ch.spectrum.at (bin) * weight;
                let imag = bin > 0 && bin < nyquist ? ch.spectrum.at (nyquist + bin) * weight : 0.0f;
                let turnReal = e.plans[b].turnReal[k];
                let turnImag = e.plans[b].turnImag[k];
                let t = wrap<numBins> (target);
                e.shiftedReal[t] += real * turnReal - imag * turnImag;
                e.shiftedImag[t] += real * turnImag + imag * turnReal;

                let level = ch.measuredLevel[k] * weight;

                if (level > e.shiftedPeak[t])
                {
                    e.shiftedPeak[t] = level;
                    e.shiftedBin[t] = ch.measuredBin[k] + e.plans[b].delta[k];
                }
            }

            for (wrap<numBins> k)
            {
                e.shiftedLevel[k] = sqrt (e.shiftedReal[k] * e.shiftedReal[k] + e.shiftedImag[k] * e.shiftedImag[k]);
                e.shiftedPhase[k] = atan2 (e.shiftedImag[k], e.shiftedReal[k]);
                e.movedLevel[k] += e.shiftedLevel[k];
            }
        }

        // Peaks: everything quieter than a threshold below the band's loudest bin goes. At 0
        // nothing goes; at 1 only what's within 6dB of the loudest is left.
        void keepPeaks (Engine& e, float peaks)
        {
            if (peaks <= 0.0f)
                return;

            float loudest = 0.0f;

            for (wrap<numBins> k)
                loudest = max (loudest, e.shiftedLevel[k]);

            let threshold = loudest * pow (10.0f, (-80.0f + 74.0f * peaks) / 20.0f);

            for (wrap<numBins> k)
                if (e.shiftedLevel[k] < threshold)
                    e.shiftedLevel[k] = 0.0f;
        }

        // Adds the bands back together (each at its level, taking the loudest band's phase,
        // with scatter if asked), tilts the result, turns it back into sound and adds it into
        // the output
        void resynthesise (Engine& e, Channel& ch, const Controls& c)
        {
            float before, after, unlevelled, levelled;

            for (wrap<numBins> k)
            {
                float level, plainLevel, loudest;
                float phase;
                bool isOriginal;

                for (wrap<numBands> b)
                {
                    if (! e.isActive[b])
                        continue;

                    let bandLevel = ch.bands[b].level[k];
                    let scaled = bandLevel * c.bands[b].gain;
                    level += scaled;
                    plainLevel += bandLevel;

                    if (scaled > loudest)
                    {
                        loudest = scaled;
                        phase = ch.bands[b].phase[k] + c.bands[b].scatter * float (pi) * e.rng.getBipolar();
                        isOriginal = ! c.bands[b].isFrozen;
                    }
                }

                // how much this bin's level changed, as a filter would have changed it, against
                // where the moving left it (neither the crossovers nor the moves count). Bins
                // that Peaks emptied are left out: they make no sound, and their deep notches
                // would only throw their neighbours' phases about.
                let incoming = e.movedLevel[k];
                e.logGain[k] = incoming > 1.0e-9f && level > 0.0f ? clamp (log (level / incoming * e.tiltGains[k]), -12.0f, 4.0f) : 0.0f;
                e.hasOriginalPhase[k] = isOriginal;

                e.combinedLevel[k] = level;
                e.combinedPhase[k] = phase;

                let weight = int (k) > 0 && int (k) < nyquist ? 2.0f : 1.0f;
                before += level * level * weight;
                after += level * level * weight * e.tiltGains[k] * e.tiltGains[k];
                unlevelled += plainLevel * plainLevel * weight;
                levelled += level * level * weight;
            }

            // per-sample power (a Hann frame of n samples carries 3n/8 of them, and the
            // transform multiplies the power by n), so the two engines can be added together
            let perSample = 8.0f / (3.0f * float (fftSize) * float (fftSize));
            e.levelled += (levelled * perSample - e.levelled) * 0.2f;
            e.unlevelled += (unlevelled * perSample - e.unlevelled) * 0.2f;

            // tilt changes the colour, not the loudness
            let normalise = before > 1.0e-20f && after > 1.0e-20f ? sqrt (before / after) : 1.0f;

            if (c.useMinimumPhase)
                findMinimumPhase (e);

            for (wrap<numBins> k)
            {
                let bin = int (k);
                let level = e.combinedLevel[k] * e.tiltGains[k] * normalise;
                let phase = c.useMinimumPhase && e.hasOriginalPhase[k] ? e.combinedPhase[k] + e.minimumPhase[k] : e.combinedPhase[k];

                ch.displayLevel[k] = level;
                ch.spectrum.at (bin) = level * cos (phase);

                if (bin > 0 && bin < nyquist)
                    ch.spectrum.at (nyquist + bin) = level * sin (phase);
            }

            std::frequency::realOnlyInverseFFT (ch.spectrum, ch.frame);

            wrap<fftSize> target = e.position;

            for (wrap<fftSize> i)
            {
                ch.outgoing[target] += ch.frame[i] * e.window[i] * colaGain;
                ++target;
            }
        }

        // The minimum phase of the gain curve in logGain, from its cepstrum: the cepstrum's
        // negative-time half is folded onto its positive half, and what that turns into
        // (back in the frequency domain) is the log of a filter with the same levels whose
        // response all comes after time zero. Its imaginary part is that filter's phase.
        void findMinimumPhase (Engine& e)
        {
            for (wrap<numBins> k)
            {
                let bin = int (k);
                e.cepstrumSpectrum.at (bin) = e.logGain[k];

                if (bin > 0 && bin < nyquist)
                    e.cepstrumSpectrum.at (nyquist + bin) = 0.0f;
            }

            std::frequency::realOnlyInverseFFT (e.cepstrumSpectrum, e.cepstrum);

            for (wrap<fftSize> i)
            {
                let n = int (i);

                if (n > 0 && n < nyquist)
                    e.cepstrum[i] *= 2.0f;
                else if (n > nyquist)
                    e.cepstrum[i] = 0.0f;
            }

            std::frequency::realOnlyForwardFFT (e.cepstrum, e.cepstrumSpectrum);

            for (wrap<numBins> k)
            {
                let bin = int (k);
                e.minimumPhase[k] = bin > 0 && bin < nyquist ? e.cepstrumSpectrum.at (nyquist + bin) : 0.0f;
            }
        }

        //==============================================================================
        // A gain per bin for the tilt, pivoting around 1kHz
        void updateTiltGains (Engine& e, const Controls& c)
        {
            e.lastTilt = c.tilt;
            let binWidth = e.sampleRate / float (fftSize);

            for (wrap<numBins> k)
            {
                let frequency = max (20.0f, float (max (1, int (k))) * binWidth);
                e.tiltGains[k] = pow (10.0f, c.tilt * log (frequency / 1000.0f) / log (2.0f) / 20.0f);
            }
        }

        // Splits the bins between the bands, and between the engines. Each band crossover
        // fades over a third of an octave either side, and the high one is kept at least half
        // an octave above the low one; the engines hand over at engineSplit, fading over a
        // sixth of an octave either side. A band is only rendered by an engine that has some
        // of it, and one that's just come back starts from silence rather than whatever it
        // held before.
        void updateBandWeights (Engine& e, const Controls& c)
        {
            e.lastLowCross = c.lowCross;
            e.lastHighCross = c.highCross;

            let binWidth = e.sampleRate / float (fftSize);
            let lowOctave = log (max (c.lowCross, 20.0f)) / log (2.0f);
            let highOctave = max (log (max (c.highCross, 20.0f)) / log (2.0f), lowOctave + 0.5f);
            let splitOctave = log (engineSplit) / log (2.0f);
            bool[numBands] isNowActive;

            for (wrap<numBins> k)
            {
                let octave = log (max (float (int (k)) * binWidth, 10.0f)) / log (2.0f);
                let aboveLow = fade ((octave - lowOctave) * 1.5f);
                let aboveHigh = fade ((octave - highOctave) * 1.5f);
                let aboveSplit = fade ((octave - splitOctave) * 6.0f);
                let share = e.isAnalyser ? 1.0f - aboveSplit : aboveSplit;

                e.bandWeights[0, k] = (1.0f - aboveLow) * share;
                e.bandWeights[1, k] = (aboveLow - aboveHigh) * share;
                e.bandWeights[2, k] = aboveHigh * share;

                for (wrap<numBands> b)
                    if (e.bandWeights[b, k] > 0.0f)
                        isNowActive[b] = true;
            }

            for (wrap<numBands> b)
            {
                if (isNowActive[b] && ! e.isActive[b])
                {
                    for (wrap<numBins> k)
                    {
                        e.left.bands[b].level[k] = 0.0f;
                        e.right.bands[b].level[k] = 0.0f;
                    }
                }

                e.isActive[b] = isNowActive[b];
            }
        }

        /// The loudest output level (relative to full scale, both channels averaged) between
        /// two frequencies
        float getDisplayLevel (const Engine& e, float lowFrequency, float highFrequency)
        {
            let binWidth = e.sampleRate / float (fftSize);
            let firstBin = clamp (int (lowFrequency / binWidth), 1, nyquist);
            let lastBin = clamp (int (highFrequency / binWidth), firstBin, nyquist);
            float level;

            for (int bin = firstBin; bin <= lastBin; ++bin)
                level = max (level, (e.left.displayLevel.at (bin) + e.right.displayLevel.at (bin)) * 0.5f);

            return level * 2.0f / float (fftSize);
        }
    }
}
